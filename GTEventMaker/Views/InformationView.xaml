<UserControl x:Class="GTEventMaker.Views.InformationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GTEventMaker.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="604" d:DesignWidth="1154"

             DataContextChanged="UserControl_DataContextChanged">
    <Grid>
        <Grid>
            <GroupBox Margin="10,10,0,10" HorizontalAlignment="Left" Width="608">
                <GroupBox.Header>
                    <Grid>
                        <TextBlock Text="Localization"/>
                        <TextBlock Text="Language:" Margin="323,1,-183,-1"/>
                        <ComboBox Name="cb_InfoLanguage" Width="200" Margin="388,0,-388,0" SelectionChanged="cb_InfoLanguage_SelectionChanged"/>
                    </Grid>
                </GroupBox.Header>
                <Grid>
                    <Label Content="Title" Margin="10,10,0,0" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Width="50" >
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Title</TextBlock>
                                <LineBreak/>
                                Title for the event.<LineBreak/>
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->title</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Name="txt_EventTitle" Height="20" Width="450" HorizontalAlignment="Left" VerticalAlignment="Top" TextChanged="txtEventName_TextChanged" Margin="136,11,0,0"/>
                    <Button Content="Set to All Locales" Height="22" Click="btn_TitleApplyAllLocales_Click" Margin="470,36,20,0" VerticalAlignment="Top"/>

                    <Label Content="One Line Title" Margin="10,63,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="123">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">One Line Title</TextBlock> <LineBreak />
                                For GT6 only. <LineBreak />
                                One line title, will display in non regular folders, below the event card (scrolling if larger than screen width). <LineBreak/>
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->one_line_title</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Name="txt_OneLineTitle" Height="22" Width="450" HorizontalAlignment="Left" VerticalAlignment="Top" TextChanged="txt_OneLineTitle_TextChanged" Margin="136,67,0,0" />
                    <Button Content="Set to All Locales"  Height="22" Click="btn_OneLineTitleApplyAllLocales_Click" Margin="470,94,20,0" VerticalAlignment="Top"/>

                    <Label Content="Description"  Margin="10,117,0,0" Height="27" VerticalAlignment="Top" HorizontalAlignment="Left" Width="123">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Description</TextBlock> <LineBreak />
                                For GT6 only. <LineBreak />
                                Description to show on the Event Info screen. Can have multiple lines and symbols. <LineBreak/>
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->description</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Name="txt_Description" Height="218" Width="448" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" TextChanged="txt_Description_TextChanged" Margin="138,124,0,0" />
                    <Button Content="Set to All Locales" Height="22" Click="btn_DescriptionApplyAllLocales_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="469,409,0,0" Width="116"/>

                    <Label Content="Advanced Notice" Width="101" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,378,0,0">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Description</TextBlock> <LineBreak />
                                For GT6 only. <LineBreak />
                                Key name to use for EULA, passed to EventRace2.requestEula. Mostly for online events such as seasonals.<LineBreak/>
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->advanced_notice</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Name="txt_AdvancedNotice" TextChanged="txt_AdvancedNotice_TextChanged" Height="26" Width="450" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" Margin="136,378,0,0" />
                    <Button Content="Set to All Locales" Click="btn_AdvancedNoticeApplyAllLocales_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="470,347,0,0" Width="116"/>

                    <Label Content="Registration Notice" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,440,0,0">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Description</TextBlock> <LineBreak />
                                For GT6 only. <LineBreak />
                                Text to use when a registration error occurs, only if event.ranking.registration_type is set to ENTRY or RANKING.<LineBreak/>
                                Mostly for online events such as seasonals.<LineBreak/>
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->registration_notice</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Name="txt_RegistrationNotice" TextChanged="txt_RegistrationNotice_TextChanged" Height="26" Width="450" HorizontalAlignment="Left" VerticalAlignment="Top" TextWrapping="Wrap" AcceptsReturn="True" Margin="136,440,0,0" />
                    <Button Content="Set to All Locales" Height="22" Click="btn_RegistrationNoticeApplyAllLocales_Click" VerticalAlignment="Top" Margin="468,472,20,0"/>

                </Grid>
            </GroupBox>
            <GroupBox Header="Extra Info" Margin="623,10,10,10">
                <Grid>
                    <Label Content="Logo Image Path" Margin="10,10,0,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Width="113">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Logo Image Path</TextBlock> <LineBreak />
                                Logo to display for this event. Used for Seasonals/Online Events.<LineBreak />
                                Can point to a local game file, otherwise a file online.<LineBreak/>
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->logo_image_path</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Name="txt_LogoImagePath" Height="20" VerticalAlignment="Top" TextChanged="txt_LogoImagePath_TextChanged" Margin="115,14,10,0" />

                    <Label Content="Logo Image Layout" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,39,0,0">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Logo Image Layout</TextBlock> <LineBreak />
                                Used for GT6 Seasonal Events. How the image is displayed.<LineBreak />
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->logo_image_layout</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:ByteUpDown Name="iud_LogoImageLayout" ValueChanged="iud_LogoImageLayout_ValueChanged" Height="20" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" VerticalAlignment="Top" Margin="127,42,10,0"/>

                    <Label Content="Logo Other Info" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,70,0,0">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Logo Other Info</TextBlock> <LineBreak />
                                Unknown. Not used by GT5 and GT6.<LineBreak />
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->logo_other_info</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Name="txt_LogoOtherInfo" Height="20" VerticalAlignment="Top" TextChanged="txt_LogoOtherInfo_TextChanged" Margin="115,73,10,0" />

                    <Label Content="TODO Logo Image Buffer" HorizontalContentAlignment="Center" VerticalAlignment="Top" Width="346" Margin="10,101,0,0"/>
                    <Separator Margin="10,132,10,0" Height="3" VerticalAlignment="Top"/>

                    <Label Content="Flier Image Path" Margin="10,140,399,0" Height="28" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Flier Image Path</TextBlock> <LineBreak />
                                Used for GT5 Seasonals/Online Events.<LineBreak />
                                Can point to a local game file, otherwise a file online.<LineBreak/>
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->flier_image_path</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Name="txt_FlierImagePath" Height="20" VerticalAlignment="Top" Margin="115,144,10,0" TextChanged="txt_FlierImagePath_TextChanged" />

                    <Label Content="Flier Other Info" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,171,0,0" Width="100">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Flier Other Info</TextBlock> <LineBreak />
                                Unknown. Not used by GT5 and GT6.<LineBreak />
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->flier_other_info</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Name="txt_FlierOtherInfo" Height="20" VerticalAlignment="Top" Margin="115,175,10,0" TextChanged="txt_FlierOtherInfo_TextChanged" />
                    <Label Content="TODO Flier Image Buffer" HorizontalContentAlignment="Center" VerticalAlignment="Top" Width="346" Margin="86,202,77,0"/>
                    <Separator Margin="10,233,10,0" Height="3" VerticalAlignment="Top"/>

                    <Label Content="Race Label" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,241,0,0" Width="100">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Race Label</TextBlock> <LineBreak />
                                Unknown. Not used by GT5 and GT6.<LineBreak />
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->race_label</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox Name="txt_RaceLabel" Height="20" VerticalAlignment="Top" Margin="115,244,10,0" TextChanged="txt_RaceLabel_TextChanged" />

                    <Label Content="Race Info Minute" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,272,0,0">
                        <Label.ToolTip>
                            <TextBlock>
                                <TextBlock FontWeight="Bold" FontSize="14">Race Info Minute</TextBlock> <LineBreak />
                                Estimated time of the race. Used for display in Online B-Spec events (GT5).<LineBreak />
                                <LineBreak/>
                                <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">information->race_info_minute</TextBlock>
                             </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:UShortUpDown Name="iud_RaceInfoMinute" ValueChanged="iud_RaceInfoMinute_ValueChanged" Height="20" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" VerticalAlignment="Top" Margin="127,277,10,0"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
