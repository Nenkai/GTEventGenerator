<UserControl x:Class="GTEventMaker.Views.ReplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GTEventMaker.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="604" d:DesignWidth="1154"
             DataContextChanged="UserControl_DataContextChanged">
    <Grid>
        <GroupBox Header="Replay Parameters" Margin="10,10,767,251">
            <Grid>
                <Label Content="Local Path" Margin="10,10,0,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Width="95">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Local Path</TextBlock><LineBreak />
                            Local path to the replay to use.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">replay->local_path</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <TextBox Name="tb_LocalPath" TextChanged="tb_LocalPath_TextChanged" Margin="110,12,0,0" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="255"/>

                <Separator Margin="13,104,0,0" Height="5" VerticalAlignment="Top" HorizontalAlignment="Left" Width="352"/>

                <Label Content="Url" Margin="10,40,0,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Width="95">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Url</TextBlock><LineBreak />
                            URL to the replay to use.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">replay->url</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <TextBox Name="tb_Url" TextChanged="tb_Url_TextChanged"  Margin="110,43,0,0" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="255"/>

                <Label Content="Demo Data Path" Margin="10,72,0,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Width="100">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Demo Data Path</TextBlock><LineBreak />
                            Demo data path to use.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">replay->demo_data_path</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <TextBox Name="tb_DemoDataPath" TextChanged="tb_DemoDataPath_TextChanged"  Margin="110,74,0,0" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="255"/>

                <Label Content="Replay Recording Quality" Margin="10,114,0,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Width="173">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Replay Recording Quality</TextBlock><LineBreak />
                            Replay recording quality.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->replay_recording_quality</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_ReplayRecordingQuality" SelectionChanged="cb_ReplayRecordingQuality_SelectionChanged" Margin="188,116,0,0" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="176"/>

                <CheckBox Name="cb_AutoSave" Content="Auto Save" Margin="13,141,0,0" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left" Width="222"
                          Checked="cb_AutoSave_Checked" Unchecked="cb_AutoSave_Checked" >
                    <CheckBox.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Auto Save</TextBlock><LineBreak />
                            Whether to auto save replay on exit<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->auto_save</TextBlock>
                        </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
