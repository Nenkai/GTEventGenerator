<UserControl x:Class="GTEventMaker.Views.PlayStyleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GTEventMaker.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="604" d:DesignWidth="1154"
             DataContextChanged="UserControl_DataContextChanged">
    <Grid>
        <GroupBox Header="Play Style" Margin="10,5,890,0" Height="329" VerticalAlignment="Top">
            <Grid>
                <Label Margin="10,10,0,0" Content="B-Spec Type" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="99">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">A/B Spec</TextBlock>
                            <LineBreak/>
                            - <TextBlock FontWeight="Bold">A-Spec Only</TextBlock>: Player can participate in the race and drive the car.
                            <LineBreak/>
                            - <TextBlock FontWeight="Bold">B-Spec Only</TextBlock>: An AI will drive the car, and the player influences how the AI drives.
                            <LineBreak/>
                            - <TextBlock FontWeight="Bold">Both A and B</TextBlock>: Both are allowed.
                            <LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">play_style->bspec_type</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_BSpecType" SelectionChanged="cb_BSpecType_SelectionChanged" Margin="93,11,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="150"/>

                <Label Margin="10,41,0,0" Content="Play Type" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="99">
                    <Label.ToolTip>
                        <TextBlock>
                             <TextBlock FontWeight="Bold" FontSize="14">Play Type</TextBlock>
                             <LineBreak/>
                             Whether if the event is a regular event or demo, should leave as Race
                             - <TextBlock FontWeight="Bold">A-Spec</TextBlock>: Player can participate in the race and drive the car.
                             <LineBreak/>
                             <LineBreak/>
                             <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">play_style->play_type</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_PlayType" SelectionChanged="cb_PlayType_SelectionChanged" Margin="93,42,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="150"/>

                <CheckBox Name="cb_NoQuickMenu" Checked="cb_NoQuickMenu_Checked" Unchecked="cb_NoQuickMenu_Checked" Content="No Quick Menu" Margin="10,73,0,0" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Width="233">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">No Quick Menu</TextBlock> <LineBreak />
                                    Whether pausing is NOT allowed<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">play_style->no_quick_menu</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox Name="cb_NoInstantReplay" Checked="cb_NoInstantReplay_Checked" Unchecked="cb_NoInstantReplay_Checked" Content="No Instant Replay" Margin="10,103,0,0" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Width="233">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">No Instant Replay</TextBlock> <LineBreak />
                                    Whether a replay after the race is NOT displayed.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">play_style->no_instant_replay</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="cb_ReplayRecordingEnable" Content="Replay Recording Enabled" Checked="cb_ReplayRecordingEnable_Checked" Unchecked="cb_ReplayRecordingEnable_Checked" Margin="10,133,0,0" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Width="233">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">No Instant Replay</TextBlock> <LineBreak />
                                    Whether a replay is recorded.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">play_style->replay_record_enable</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox Name="cb_RentCarSettingEnable" Content="Rent Car Setting Enabled" Checked="cb_RentCarSettingEnable_Checked" Unchecked="cb_RentCarSettingEnable_Checked" Margin="10,163,0,0" Height="25" VerticalAlignment="Top" HorizontalAlignment="Left" Width="233">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Rent Car Setting Enabled</TextBlock> <LineBreak />
                                    Unknown or unused. Possibly GT6 only.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">play_style->rentcar_setting_enable</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <Label Margin="10,193,0,0" Content="Window Number" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="113">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Window Number</TextBlock> <LineBreak />
                            Number of windows, i.e 2 for Splitscreen. Sensitive setting.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">play_style->window_num</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                
                <xctk:IntegerUpDown Name="iud_WindowNumber" ValueChanged="iud_WindowNumber_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="123,196,0,0" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" />

                <Label Margin="10,225,0,0" Content="Time Limit" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="113">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Time Limit</TextBlock> <LineBreak />
                            For demos. Time limit.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">play_style->time_limit</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_TimeLimit" ValueChanged="iud_TimeLimit_ValueChanged"  BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="123,228,0,0" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" />

                <Label Margin="10,256,0,0" Content="Leave Limit" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="113">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Leave Limit</TextBlock> <LineBreak />
                            For demos. Leave limit (in seconds).<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">play_style->leave_limit</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_LeaveLimit" ValueChanged="iud_LeaveLimit_ValueChanged"  BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="123,259,0,0" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
