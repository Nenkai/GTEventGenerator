<UserControl x:Class="GTEventMaker.Views.RaceParameterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GTEventMaker.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="604" d:DesignWidth="1154"
             DataContextChanged="UserControl_DataContextChanged">
    <Grid>
        <GroupBox HorizontalAlignment="Left" Width="873" Margin="10,10,0,10" >
            <GroupBox.Header>
                <TextBlock Text="General"/>
            </GroupBox.Header>
            <Grid>
                <Label Content="Entry Max" Height="28" Width="74" TabIndex="61" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,787,0" >
                    <Label.ToolTip>
                        <TextBlock>
                              <TextBlock FontWeight="Bold" FontSize="14">Entry Max</TextBlock> <LineBreak />
                              Undocumented<LineBreak/>
                              <LineBreak/>
                              <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->entry_max</TextBlock>
                              </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_EntryMax" ValueChanged="numericUpDown_EntryMax_ValueChanged" Height="20" Maximum="16" Minimum="0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="75,13,737,0" VerticalAlignment="Top"/>

                <Label Content="Racers Max" Height="27" Width="79" TabIndex="61" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,657,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                 <TextBlock FontWeight="Bold" FontSize="14">Max Cars</TextBlock>
                                 <LineBreak/>
                                 How many cars are allowed on the track at once. <LineBreak/>
                                 Max is 16. <LineBreak/>
                                 <LineBreak/>
                                 <TextBlock FontWeight="Bold" Foreground="Red">IMPORTANT:</TextBlock> Be <TextBlock FontWeight="Bold">VERY</TextBlock> aware when using this value especially with (large) Custom Tracks. <LineBreak/>
                                 It affects directly the memory allocated for the entries and may cause a crash/freeze during track loading.
                                 <LineBreak/>
                                 <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->racers_max</TextBlock>
                             </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_RacersMax" ValueChanged="numericUpDown_RacersMax_ValueChanged" Height="20" Maximum="16" Minimum="0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="206,13,607,0" VerticalAlignment="Top"/>


                <CheckBox Name="checkBox_AutostartPitout" Content="Autostart Pitout" Height="24" Width="154" TabIndex="63" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,139,22,0" 
                          Checked="checkBox_AutostartPitout_Checked" Unchecked="checkBox_AutostartPitout_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Autostart Pitout</TextBlock> <LineBreak />
                                    Unknown/Undocumented<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->autostart_pitout</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <Label Name="label_Flagset" Content="Flagset" Height="32" Width="54" TabIndex="61" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,196,546,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Flagset</TextBlock> <LineBreak />
                                    Unknown/Undocumented (GT5 only?)<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->flagset</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_Flagset" Height="21" Width="116" TabIndex="62" HorizontalAlignment="Right" VerticalAlignment="Top" SelectionChanged="comboBox_Flagset_SelectedIndexChanged" Margin="0,199,371,0" />

                <Label Name="label_RaceType" Content="Race Type" Height="32" Width="70" TabIndex="61" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,225,530,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Race Type</TextBlock> <LineBreak />
                                    Undocumented - would not touch<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->race_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_RaceType" Height="20" TabIndex="62" VerticalAlignment="Top" SelectionChanged="comboBox_RaceType_SelectedIndexChanged" Margin="384,231,371,0" />

                <Label Content="Start Signal Type" Height="32" Width="105" TabIndex="61" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,343,495,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Start Signal Type</TextBlock> <LineBreak />
                                    Unknown. GT6 Only.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->start_signal_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_StartSignalType" Height="20" Width="91" TabIndex="62" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="comboBox_StartSignalType_SelectionChanged" Margin="409,347,0,0" />

                <Label Content="Low Grip Setting" Height="32" TabIndex="61" VerticalAlignment="Top" Margin="271,257,0,0" HorizontalAlignment="Left" Width="104">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Low Grip Setting</TextBlock> <LineBreak />
                                    Set the amount of grip that is lost when driving on wet roads or the outer edges of the track (green zones, etc).<LineBreak />
                                    When set to "Low", the amount of grip lost will be less than in real life.<LineBreak /> 
                                    When set to "Real", the road will become very slippery in wet conditions, and it will be very easy to lose grip on the edges of the track.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->low_mu_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_LowMuType" Height="22" Width="116" TabIndex="62" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="comboBox_LowMuType_SelectedIndexChanged" Margin="384,260,0,0" />

                <Label Content="Attack Separate Type" Height="32" TabIndex="61" VerticalAlignment="Top" Margin="271,487,0,0" HorizontalAlignment="Left" Width="136">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Attack Separate Type</TextBlock> <LineBreak />
                                    GT6 Only.<LineBreak />
                                    Select "Race Alone" (ALONE) to take part in the event with other cars visible only as ghosts that cannot be bumped into.<LineBreak/>
                                    Select "Race Together" (ALL MEMBERS) to take to the track en masse.<LineBreak /> 
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->attack_separate_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_AttackSeparateType" Height="22" Width="89" TabIndex="62" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="comboBox_AttackSeparateType_SelectionChanged" Margin="411,491,0,0" />

                <Label Name="label_MaxGhostLines" Content="Max Ghost Lines" Height="24" Width="131" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,167,469,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Max Ghost Lines</TextBlock> <LineBreak />
                                    The maximum ghost lines (GT6 Seasonals) to show, if enabled.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->line_ghost_play_max</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_MaxGhostLines" Height="20" ValueChanged="numericUpDown_MaxGhostLines_ValueChanged" Maximum="16" Minimum="0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="384,169,371,0" VerticalAlignment="Top"/>

                <Label Content="Mu Ratio 100" Height="24" Width="88" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,277,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Mu Ratio 100</TextBlock> <LineBreak />
                                    Unknown.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->mu_ratio100</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_MuRatio100" Height="20" ValueChanged="numericUpDown_MuRatio100_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="624,19,189,0" VerticalAlignment="Top"/>

                <Label Content="Temperature Tire" Height="24" Width="105" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,47,260,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Temperature Tire</TextBlock> <LineBreak />
                                    GT6 Only. Unknown.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->temperature_tire</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_TemperatureTire" Height="20" ValueChanged="numericUpDown_TemperatureTire_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="624,49,187,0" VerticalAlignment="Top"/>

                <Label Content="Temperature Brake" Height="24" Width="115" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,76,250,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Temperature Brake</TextBlock> <LineBreak />
                                    GT6 Only. Unknown.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->temperature_brake</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_TemperatureBrake" Height="20" ValueChanged="numericUpDown_TemperatureBrake_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="624,80,187,0" VerticalAlignment="Top"/>

                <Label Content="Temperature Engine" Height="28" Width="126" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,105,239,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Temperature Engine</TextBlock> <LineBreak />
                                    GT6 Only. Unknown.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->temperature_engine</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_TemperatureEngine" Height="20" ValueChanged="numericUpDown_TemperatureEngine_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="624,109,187,0" VerticalAlignment="Top"/>

                <Label Content="B-Spec Vitality 10" Height="24" Width="106" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,288,494,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">B-Spec Vitality 10</TextBlock> <LineBreak />
                                    Unknown.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->bspec_vitality10</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="numericUpDown_BSpecVitality10" Height="20" Width="91" ValueChanged="numericUpDown_BSpecVitality10_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="409,291,371,0" VerticalAlignment="Top"/>


                <Label Content="Start Time Offset" Height="24" Width="106" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,315,494,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Start Time Offset</TextBlock> <LineBreak />
                                    Unknown. GT6 Only.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->start_time_offset</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_StartTimeOffset" Height="20" Width="91" ValueChanged="numericUpDown_StartTimeOffset_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="409,319,371,0" VerticalAlignment="Top"/>

                <Label Content="Consideration Type" Height="25" Width="132" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,372,468,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Consideration Type</TextBlock> <LineBreak />
                                    Unknown. GT6 Only.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">0</TextBlock>: Never.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">1</TextBlock>: Regular Penalty (pit-through time addition)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">2</TextBlock>: Immediate penalty (reset) after judgment<LineBreak/>                                  
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->consideration_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_ConsiderationType" Height="20" Width="91" ValueChanged="numericUpDown_ConsiderationType_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="409,376,371,0" VerticalAlignment="Top"/>

                <Label Content="Mandatory Pit Stops" Height="29" Width="132" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,402,468,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Mandatory Pit Stops</TextBlock> <LineBreak />
                                    How many times pitting is required during a race. GT6 Only.<LineBreak/>
                                    Race Type must be set to COMPETITION.
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->pit_constraint</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_PitConstraint" Height="20" Width="91" ValueChanged="numericUpDown_PitConstraint_ValueChanged"  BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="409,406,371,0" VerticalAlignment="Top"/>

                <Label Content="Course Out Penalty Margin" Height="29" Width="159" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,430,441,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Course Out Penalty Margin</TextBlock> <LineBreak />
                                    Unknown. GT6 Only.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->course_out_penalty_margin</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_CourseOutPenaltyMargin" Height="20" ValueChanged="numericUpDown_CourseOutPenaltyMargin_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="430,434,371,0" VerticalAlignment="Top"/>

                <Label Content="Behavior Fallback" Height="28" Width="116" TabIndex="59" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,460,484,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Behavior Fallback</TextBlock> <LineBreak />
                                    Unknown. GT6 Only.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->behavior_fallback</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="numericUpDown_BehaviorFallback" Height="20" ValueChanged="numericUpDown_BehaviorFallback_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="411,464,371,0" VerticalAlignment="Top"/>

                <Label Name="label_LineGhostRecordType" Content="Line Ghost Record Type" Height="26" Width="136" TabIndex="57" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,136,464,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Line Ghost Record Type</TextBlock> <LineBreak />
                                    The way ghost lines will show, if enabled. GT6 Only.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->line_ghost_record_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_LineGhostRecordType" Height="20" Width="86" TabIndex="58" HorizontalAlignment="Right" VerticalAlignment="Top" SelectionChanged="comboBox_LineGhostRecordType_SelectedIndexChanged" Margin="0,140,371,0" />
                <CheckBox Name="checkBox_ReplaceAtCourseout" Content="Reset Car on Offtrack" Height="24" Width="154" TabIndex="55" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="696,258,0,0" 
                          Checked="checkBox_ReplaceAtCourseout_Checked" Unchecked="checkBox_ReplaceAtCourseout_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Reset Car on Offtrack</TextBlock> <LineBreak />
                                    Whether the car gets reset after being offtrack for a certain amount of time.<LineBreak/>
                                    Useful for lower difficulties events, where a crash would not respawn you on the track, causing more time loss.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->replace_at_courseout</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox Name="checkBox_KeepLoadGhost" Content="Keep Load Ghost" Height="24" Width="154" TabIndex="55" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="696,288,0,0" 
                          Checked="checkBox_KeepLoadGhost_Checked" Unchecked="checkBox_KeepLoadGhost_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Keep Load Ghost</TextBlock> <LineBreak />
                                    Unknown.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->keep_load_ghost</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox Name="checkBox_GoalTimeUseLapTotal" Content="Goal Time Use Lap Total" Height="24" Width="154" TabIndex="55" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="696,317,0,0" 
                          Checked="checkBox_GoalTimeUseLapTotal_Checked" Unchecked="checkBox_GoalTimeUseLapTotal_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Goal Time Use Lap Total</TextBlock> <LineBreak />
                                    Unknown. GT6 Only.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->goal_time_use_lap_total</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox Name="checkBox_NeedTireChange" Content="Mandatory Tire Change" Height="24" Width="154" TabIndex="55" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="696,344,0,0" 
                          Checked="checkBox_MandatoryTireChange_Checked" Unchecked="checkBox_MandatoryTireChange_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Mandatory Tire Change</TextBlock> <LineBreak />
                                    GT6 Only. Whether a tire change is required in the race.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->need_tire_change</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_BoostType" Content="Boost Type" Height="24" Width="154" TabIndex="55" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,444,22,0" 
                          Checked="checkBox_BoostType_Checked" Unchecked="checkBox_BoostType_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Boost Type</TextBlock> <LineBreak />
                                    Enables reference rank in boost tables (GT6).<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->boost_type</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox Name="checkBox_OnlineOn" Content="Online On" Height="24" Width="154" TabIndex="54" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,228,21,0" 
                          Checked="checkBox_OnlineOn_Checked" Unchecked="checkBox_OnlineOn_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Online On</TextBlock> <LineBreak />
                                    Unknown/Undocumented<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->online_on</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox Name="checkBox_PenaltyNoReset" Content="Penalty No Reset" Height="24" Width="154" TabIndex="52" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,198,21,0" 
                          Checked="checkBox_PenaltyNoReset_Checked" Unchecked="checkBox_PenaltyNoReset_Checked" >
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Penalty No Reset</TextBlock> <LineBreak />
                                    Unknown/Undocumented<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->penalty_no_reset</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox Name="checkBox_BoostFlag" Content="Boost Flag" Height="24" Width="154" TabIndex="51" HorizontalAlignment="Right" VerticalAlignment="Top" IsChecked="{Binding RaceParameters.BoostFlag}" Margin="0,471,22,0" Checked="checkBox_BoostFlag_Checked" >
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Boost Flag</TextBlock> <LineBreak />
                                    Undocumented/Unknown<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->boost_flag</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_ImmediateFinish" Content="Immediate" Height="24" Width="79" TabIndex="50" HorizontalAlignment="Left" 
                                          VerticalAlignment="Top" Margin="187,257,0,0" Checked="checkBox_ImmediateFinish_Checked" Unchecked="checkBox_ImmediateFinish_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Immediate Finish</TextBlock> <LineBreak />
                                    Whether an event that is set to complete by time will complete immediately once the timer reaches 0<LineBreak/>
                                    Or the "final" lap has to be completed.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->immediate_finish</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_PaceNote" Content="Pace Note" Height="24" Width="154" TabIndex="49" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,169,21,0" 
                          Checked="checkBox_PaceNote_Checked" Unchecked="checkBox_PaceNote_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Pace Note</TextBlock> <LineBreak />
                                    Undocumented/Unknown<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->pace_note</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_CoDriver" Content="Allow Co-Driver" Height="24" Width="154" TabIndex="47" HorizontalAlignment="Right" 
                                      VerticalAlignment="Top" Margin="0,107,21,0" Checked="checkBox_CoDriver_Checked" Unchecked="checkBox_CoDriver_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Co Driver</TextBlock> <LineBreak />
                                    Undocumented, GT5 only <LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->allow_codriver</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_Accumulation" Content="Oil Breakdown/Tire Wear" Height="24" Width="154" TabIndex="46" HorizontalAlignment="Right" 
                                      VerticalAlignment="Top" Margin="0,76,21,0" Checked="checkBox_Accumulation_Checked" Unchecked="checkBox_Accumulation_Checked" >
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Oil Breakdown/Tire Wear</TextBlock> <LineBreak />
                                    Whether to allow Tire/Oil Wear<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->accumulation</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_AcademyEvent" Content="Academy Event" Height="24" Width="154" TabIndex="45" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,47,21,0" 
                          Checked="checkBox_AcademyEvent_Checked" Unchecked="checkBox_AcademyEvent_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Academy Event</TextBlock> <LineBreak />
                                    Undocumented<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->academy_event</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_DisableReplayRecord" Content="Disable Replay Recording" Height="24" Width="154" TabIndex="44" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="696,17,0,0" 
                          Checked="checkBox_DisableReplayRecord_Checked" Unchecked="checkBox_DisableReplayRecord_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Display Replay Recording</TextBlock> <LineBreak />
                                    If enabled, replay recording will not be available.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->disable_recording_replay</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <Button Name="btn_BoostTable" Content="Setup Boost Tables (GT6)" Height="33" Click="btn_BoostTable_Click" Margin="695,500,15,0" VerticalAlignment="Top">
                    <Button.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Boost Tables (GT6)</TextBlock> <LineBreak />
                                    Advanced users only and GT6 only. Setup Boost/Rubberbanding settings.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->boost_table_array</TextBlock>
                                    </TextBlock>
                    </Button.ToolTip>
                </Button>

                <Label Name="label_SlipstreamBehavior" Content="Slipstream Behavior" Height="24" Width="118" TabIndex="41" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,104,482,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Slipstream Behavior</TextBlock> <LineBreak />
                                    Sets the strength of the slipstream generated by cars.<LineBreak /> 
                                    Slipstream is a force that sucks a car closer to the car in front of it when traveling at high speeds - <LineBreak /> 
                                    an effect caused by differences in air pressure.<LineBreak /> 
                                    <LineBreak /> 
                                    Select "Strong" for a strong slipstream effect, and "Weak" for a weaker effect.<LineBreak /> 
                                    For an even weaker slipstream effect, select "Real." <LineBreak />
                                    <LineBreak /> 
                                    Selecting either "Weak" or "Real" will lessen the effects of slipstream, while at the same time replicating<LineBreak/>
                                    the loss of downforce on the slipstreaming car that occurs in real life.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->behavior_slipstream_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_SlipstreamBehavior" Height="21" Width="100" TabIndex="43" HorizontalAlignment="Right" VerticalAlignment="Top" SelectionChanged="comboBox_SlipstreamBehavior_SelectedIndexChanged" Margin="0,108,371,0" />

                <Label Name="label_PenaltyLevel" Content="Penalty Level" Height="27" Width="88" TabIndex="39" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,74,512,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Penalty Level</TextBlock> <LineBreak />
                                    How severe penalties are - Default depends on game mode, i.e lap was invalidated on a time trial<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->penalty_level</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_PenaltyLevel" Height="21" Width="116" TabIndex="40" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="comboBox_PenaltyLevel_SelectedIndexChanged" Margin="384,77,0,0" />

                <Label Name="label_LightingMode" Content="Lighting Mode" Height="27" Width="88" TabIndex="37" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,44,512,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Lighting Mode</TextBlock> <LineBreak />
                                    How cars behave to upcoming night. (Mainly Undocumented)<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->lighting_mode</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_LightingMode" Height="20" Width="116" TabIndex="38" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="comboBox_LightingMode_SelectedIndexChanged" Margin="384,48,0,0" />

                <Label Name="label_GridSortType" Content="Grid Sort Type" Width="88" TabIndex="35" HorizontalAlignment="Right" Margin="0,14,512,0" Height="28" VerticalAlignment="Top">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Grid Sort Type</TextBlock> <LineBreak />
                                    Decide on the order in which cars line up when starting from the grid. 
                                    <!--
                                    If you choose “Grid Based on Previous Race Results,” 
                                    cars will line up in the order in which they finished in the previous race, from the fastest to the slowest, 
                                        and if you select "Reverse Grid Based on Previous Race Results," they will line up in the reverse order.<LineBreak/>-->
                                    <LineBreak/> 
                                    - <TextBlock FontWeight="Bold">None</TextBlock>: No Sorting.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Random</TextBlock>: Grid entries sorted randomly.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">By Points</TextBlock>: Based on current championship points.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Reverse Points Grid</TextBlock>: Based on current championship points, but reverse.<LineBreak/> 
                                    - <TextBlock FontWeight="Bold">Fastest First</TextBlock>: Cars will line up in the order of their times in the pre-race practice run, from the fastest to the slowest.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Fastest Last</TextBlock>: Same as above, line up in the reverse order.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Based on Ranks</TextBlock>: Undocumented (?)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Reverse Ranks</TextBlock>: Undocumented (?)<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->grid_sort_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_GridSortType" Height="20" Width="116" TabIndex="38" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="comboBox_GridSortType_SelectedIndexChanged" Margin="384,18,0,0"/>

                <Label Name="label_FuelConsumptionMultiplier" Content="Fuel Consumption Multiplier" Height="29" Width="169" TabIndex="32" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,488,691,0"  >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Fuel Consumption Multiplier</TextBlock> <LineBreak />
                                    Whether or not, and how quickly, fuel is consumed.<LineBreak/>
                                    In GT5 appears to be a bit - 1 = yes, 0 = no<LineBreak/>
                                    GT6 is a multiplier, 0 = off<LineBreak/>
                                    - Based on tests (GT500), 40 = 1/4 of total fuel<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->consume_fuel</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_FuelConsumptionMultiplier" Height="20" Width="70" ValueChanged="numericUpDown_FuelConsumptionMultiplier_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="185,493,616,0" VerticalAlignment="Top"/>

                <Label Name="label_TireConsumptionMultiplier" Content="Tire Consumption Multiplier" Height="29" Width="168" TabIndex="31" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,459,692,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Tire Consumption Multiplier</TextBlock> <LineBreak />
                                    Whether or not, and how quickly, tires are consumed.<LineBreak/>
                                    In GT5 appears to be a bit - 1 = yes, 0 = no<LineBreak/>
                                    GT6 is a multiplier, 0 = off<LineBreak/>
                                    - Based on tests (GT500), 80 = 1/5 of total tire wear after 2 laps, 150 = 2/5, etc<LineBreak/>

                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->consume_tire</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="numericUpDown_TireConsumptionMultiplier" Height="20" Width="70" ValueChanged="numericUpDown_TireConsumptionMultiplier_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="185,463,616,0" VerticalAlignment="Top"/>

                <Label Name="label_StartingType" Content="Starting Type" Height="28" Width="102" TabIndex="29" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,429,758,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Starting Type</TextBlock> <LineBreak />
                                    Choose how the race will start. A grid start takes place from a standstill. <LineBreak/>
                                    <LineBreak />
                                    - <TextBlock FontWeight="Bold">Grid</TextBlock>: Traditional Grid Standstill Start (GRID)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">For Time Trial</TextBlock>: Starts behind the start line (automatically sets the position for you unless custom via Initial V Coord) (ATTACK)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling Start (Start Line)</TextBlock>: Starts while the cars are moving, Starts after crossing the Start Line (ROLLING)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling (Same Accel. as Own Car)</TextBlock>: Rolling with custom vstart with rolling_start_v (ROLLING2) <LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling (Define Start Time)</TextBlock>: Rolling with custom time to start (ROLLING3)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling (Define Start and Accel)</TextBlock>: Rolling with custom Entry Start Time and Entry Acceleration (ROLLING_NOLIMIT)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Standing (Set Coordinates)</TextBlock>: Standing Start, with custom entry start coordinates (STANDING)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Double-File Rolling (Left)</TextBlock>: Rolling start takes place while the cars are moving in two columns, Cars on the Left (ROLLING_L)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Double-File Rolling (Right)</TextBlock>: Same as above, Cars on the Right (ROLLING_R)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Pit Start</TextBlock>: Starting at Pits (PIT)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">PITWORK</TextBlock>: Undocumented (Unused?)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Same Grid (collisions OFF)</TextBlock>: No info (SAME_GRID)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Dispersed</TextBlock>: No info<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Drift Position (Standing)</TextBlock>: Take drift sector information from .cinf/menudb (COURSEINFO)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Drift Position (Rolling)</TextBlock>: Same as above but rolling (COURSEINFO_ROLLING)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling Start - Dbl. File, Left Ahead</TextBlock>: No info (ROLLING_DL)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling Start - Dbl. File, Right Ahead</TextBlock>: No info (ROLLING_DR)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">FREE</TextBlock>: No info<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->start_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_StartingType" Height="21" Width="128" TabIndex="28" HorizontalAlignment="Right" VerticalAlignment="Top" SelectionChanged="comboBox_StartingType_SelectedIndexChanged" Margin="0,433,612,0" />

                <Label Name="label_GhostPresence" Content="Ghost Presence" Height="24" Width="100" TabIndex="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,400,760,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Ghost Presence</TextBlock> <LineBreak />
                                    If ghosts are enabled, how they will display.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Normal</TextBlock>: Transparent Ghost<LineBreak/>
                                    - <TextBlock FontWeight="Bold">None</TextBlock>: No Ghost (?)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Real</TextBlock>: Ghost shows as a real car<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->ghost_presence</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_GhostPresence" Height="22" Width="128" TabIndex="27" IsEnabled="False" HorizontalAlignment="Right" VerticalAlignment="Top" SelectionChanged="comboBox_GhostPresence_SelectedIndexChanged" Margin="0,403,612,0" />

                <Label Name="label_GhostType" Content="Ghost Type" Height="27" Width="78" TabIndex="25" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,370,782,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Ghost Type</TextBlock> <LineBreak />
                                    The type of ghost to display.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">One Lap</TextBlock>: Last Lap (?)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">RECORD</TextBlock>: Best Lap (?)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Others</TextBlock>: Undocumented<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->ghost_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_GhostType" Height="21" Width="128" TabIndex="24" HorizontalAlignment="Right" VerticalAlignment="Top" SelectionChanged="comboBox_GhostType_SelectedIndexChanged" Margin="0,374,612,0" />

                <Label Name="label_DamageBehavior" Content="Damage Behavior" Height="28" Width="110" TabIndex="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,342,750,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Damage Behavior</TextBlock> <LineBreak />
                                    Set the amount of damage that will be inflicted on engine, wheels etc. by collisions and crashes from one of the three settings described below. <LineBreak/>
                                    May cause wheels to wobble and rattle, prevent the car from traveling in a straight line, or stop the engine from working properly. <LineBreak/>
                                    Parts that have been damaged will be displayed on the on-screen damage indicator. <LineBreak/>
                                    <LineBreak/>
                                    - <TextBlock FontWeight="Bold">None</TextBlock>: Only external damage will be inflicted.<LineBreak/>
                                        Mechanical damage will not be inflicted, but external damage may still disrupt the car's aerodynamics, <LineBreak/>
                                        preventing the car from traveling in a straight line, and reducing top speed.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Light</TextBlock>: External damage and mechanical damage will both be inflicted. <LineBreak/>
                                        Mechanical damage will be automatically repaired after a short amount of time.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Heavy</TextBlock>: External damage and mechanical damage will both be inflicted, even after a mild impact.<LineBreak/>
                                        Damage will only be repaired if you perform a pit stop.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->behavior_damage_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_DamageBehavior" Height="20" Width="128" TabIndex="23" IsEnabled="False" HorizontalAlignment="Right" SelectionChanged="comboBox_DamageBehavior_SelectedIndexChanged" VerticalAlignment="Top" Margin="0,346,612,0" />

                <CheckBox Name="checkBox_Endless" Content="Endless (Drift)" Height="24" Width="108" TabIndex="21" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,315,746,0" Checked="checkBox_Endless_Checked" Unchecked="checkBox_Endless_Checked" >
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Endless</TextBlock> <LineBreak />
                                    For drift mode. Whether the drift event is one full lap.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->endless</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_DisableCollision" Content="Disable Collisions" Height="24" Width="124" TabIndex="20" Margin="0,315,611,0" HorizontalAlignment="Right" VerticalAlignment="Top" Checked="checkBox_DisableCollision_Checked" Unchecked="checkBox_DisableCollision_Checked" >
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Disable Collisions</TextBlock> <LineBreak />
                                    Disable collisions between cars. <LineBreak />
                                    When set to ON, other cars will become transparent and you will not be able to collide with them. <LineBreak />
                                    The slipstream effect will also be disabled.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->disable_collision</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_EnableDamage" Content="Enable Damage" Height="24" Width="110" TabIndex="19" HorizontalAlignment="Left" VerticalAlignment="Top" Checked="checkBox_EnableDamage_CheckedChanged" Unchecked="checkBox_EnableDamage_CheckedChanged" Margin="17,288,0,0">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Enable Damage</TextBlock> <LineBreak />
                                    If enabled, the player will have various levels of damage, visual or mechanical depending on 'Damage Behavior'.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->enable_damage</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_EnablePits" Content="Enable Pitting" Height="22" Width="124" TabIndex="18" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="136,289,0,0" Checked="checkBox_EnablePits_Checked" Unchecked="checkBox_EnablePits_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Enable Pitting</TextBlock> <LineBreak />
                                    If enabled, the player will drive through pits and stop for changes, else they will just drive through the pits.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->enable_pit</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <Label Name="label_MinutesToFinish" Content="Minutes to Finish" Height="28" TabIndex="16" VerticalAlignment="Top" Margin="12,256,741,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Minutes to Finish</TextBlock> <LineBreak />
                                    Amount of minutes before the event ends (excluding last lap), if the Complete Type is set to 'By Time'.<LineBreak/>
                                    If you are not using 'By Time', set to 0.<LineBreak/>
                                    An event is considered to be endurance (save feature) if the minutes are above 60 (1 hour).<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->race_limit_minute</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="numericUpDown_MinutesToFinish" Height="20" Width="46" ValueChanged="numericUpDown_MinutesToFinish_ValueChanged" Maximum="3000" Minimum="0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="132,259,683,0" VerticalAlignment="Top"/>

                <Label Name="label_LapsToFinish" Content="No. of Laps" Height="27" TabIndex="14" VerticalAlignment="Top" Margin="12,225,727,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">No. of Laps</TextBlock> <LineBreak />
                                    Amount of laps before the event ends, if the Complete Type is set to 'By Laps'.<LineBreak/>
                                    If you are not using 'By Laps', set to 0.<LineBreak/>
                                    An event is considered to be endurance (save feature) if the laps are above 50.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->race_limit_laps</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="numericUpDown_LapsToFinish" Height="20" Width="128" ValueChanged="numericUpDown_LapsToFinish_ValueChanged" Maximum="1000" Minimum="0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="132,229,601,0" VerticalAlignment="Top"/>

                <Label Name="label_TimeToStart" Content="Pre-Start Countdown (in MS)" Height="27" TabIndex="12" VerticalAlignment="Top" Margin="10,194,684,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Pre-Start Countdown</TextBlock> <LineBreak />
                                    How long the vehicles behind 1st place are given to finish before showing the result/reward screen.<LineBreak/>
                                    For a Grid Start, set to 6000 (6s, as it includes the Camera Animation and Grid Countdown)<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->time_to_start</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="numericUpDown_TimeToStart" Height="20" ValueChanged="numericUpDown_TimeToStart_ValueChanged" Maximum="100000" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="183,198,606,0" VerticalAlignment="Top"/>

                <Label Name="label_TimeToFinish" Content="Time To Finish (in MS)" Height="27" TabIndex="10" VerticalAlignment="Top" Margin="12,162,707,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Time To Finish</TextBlock> <LineBreak />
                                    Sets the amount of race time given after the player in first place crosses the finish line. If this time is too short, players in 2nd place and lower may not reach the finish line before the race ends. <LineBreak/>
                                    How long the vehicles behind 1st place are given to finish before showing the result/reward screen.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->time_to_finish</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="numericUpDown_TimeToFinish" Height="20" Width="82" ValueChanged="numericUpDown_TimeToFinish_ValueChanged" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="178,166,601,0" VerticalAlignment="Top"/>

                <Label Name="label_FinishWidth" Content="Finish Width (in M)" Height="26" TabIndex="8" VerticalAlignment="Top" Margin="12,131,714,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Finish Width</TextBlock> <LineBreak />
                                    Finish Width in Meters, use if you have a custom finish.<LineBreak/>
                                    Set to -1 for default.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->event_goal_width</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="numericUpDown_FinishWidth" Height="20" Width="82" ValueChanged="numericUpDown_FinishWidth_ValueChanged" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="178,136,601,0" VerticalAlignment="Top"/>

                <Label Content="Start VCoord" Height="28" Width="84" TabIndex="7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,103,0,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Start VCoord</TextBlock> <LineBreak />
                                    Custom start location. <TextBlock FontWeight="Bold">GT6 only, this seems unused/unimplemented (?) - Prefer using entry specific start VCoord instead.</TextBlock><LineBreak/>
                                    Meters are relative to the track. 1000 means 1km after the start line. <LineBreak/>
                                    Set to -1 for none.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->event_start_v</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="numericUpDown_StartVCoord" Height="20" Width="53" ValueChanged="numericUpDown_FinishVCoord_ValueChanged" Maximum="100000" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="106,106,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                <Label Content="Finish" Height="28" TabIndex="7" VerticalAlignment="Top" Margin="164,103,654,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Finish VCoord</TextBlock> <LineBreak />
                                    Custom finish location.<LineBreak/>
                                    Meters are relative to the track. 1000 means 1km after the start line. <LineBreak/>
                                    Set to -1 for none.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->event_goal_v</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="numericUpDown_FinishVCoord" Height="20" Width="52" ValueChanged="numericUpDown_FinishVCoord_ValueChanged" Maximum="100000" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="207,106,602,0" VerticalAlignment="Top"/>

                <ComboBox Name="comboBox_FinishType" Width="154" TabIndex="5" HorizontalAlignment="Left" SelectionChanged="comboBox_FinishType_SelectedIndexChanged" Margin="110,74,0,0" Height="22" VerticalAlignment="Top" />
                <Label Content="Finish Type" Height="27" Width="74" TabIndex="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,785,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Finish Type</TextBlock> <LineBreak />
                                    How how the final rankings are determined.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">None</TextBlock>: Undocumented<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Fastest Car</TextBlock>: First to reach the target (laps/section etc.)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Fastest Car</TextBlock>: Fastest Lap.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->finish_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>

                <ComboBox Name="comboBox_CompleteType" TabIndex="3" SelectionChanged="comboBox_CompleteType_SelectedIndexChanged" Margin="110,43,607,0" Height="22" VerticalAlignment="Top" />
                <Label Name="label_CompleteType" Content="Complete Type" Height="28" TabIndex="2" VerticalAlignment="Top" Margin="12,39,753,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Complete Type</TextBlock> <LineBreak />
                                    How the event ending is determined<LineBreak/>
                                    - <TextBlock FontWeight="Bold">None</TextBlock>: No definite ending.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">By Laps</TextBlock>: Traditional Race by Laps. Set 'No. of Laps'.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">By Section</TextBlock>: Event takes place on a track section when used with 'Finish Coordinates.'<LineBreak/>
                                    - <TextBlock FontWeight="Bold">By Stop</TextBlock>: Typically used for licenses, event ends when stopped.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">By Time</TextBlock>: Used for timed races with no definite laps - i.e 5 minutes or 24 hours races. Set 'Minutes to Finish'.<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Other</TextBlock>: Undocumented<LineBreak/>
                                    <LineBreak/>
                                    Note: For Online Drift trials, set it to None, but do not provide License Conditions. Causes rewards not to be given.<LineBreak/> 
                                    Instead, set the eval condition to drift and set the points accordingly.<LineBreak/>
                                    For Online Time Trials, set to None if you want the event to continue as the player completes laps and gets rewards.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->complete_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
            </Grid>
        </GroupBox>
        <GroupBox Margin="888,10,10,10" >
            <GroupBox.Header>
                <TextBlock Text="Weather Parameters"/>
            </GroupBox.Header>
            <Grid>
                <Button Content="Setup New Weather Steps (GT6)" Width="224" Click="NewWeatherData_Click" Height="33" Margin="15,500,15,0" VerticalAlignment="Top"/>
                <Label Name="label_WeatherAccelRetention" Content="Road Drying Speed" Height="26" TabIndex="22" VerticalAlignment="Top" Margin="9,293,85,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Road Drying Speed</TextBlock> <LineBreak />
                                    How fast the road can dry if wet. <LineBreak/>
                                    0 means it won't dry even if its sunny. 1000 means it will dry extremely quickly (Approx 7s).<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_accel_water_retention10</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="iud_WeatherAccelWaterRetention10" ValueChanged="iud_WeatherAccelWaterRetention10_ValueChanged" Height="20" Maximum="1000" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="173,296,11,0" VerticalAlignment="Top"/>

                <Label Name="label_TrackWetness" Content="Wetness at Race Start" Height="26" TabIndex="22" VerticalAlignment="Top" Margin="10,321,82,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Wetness at Race Start</TextBlock> <LineBreak />
                                    Adjusts how wet the track surface is at the start of the race. At 0%, the track is completely dry. <LineBreak/>
                                    As the value increases, the more water is present on the track, and the more slippery it will become. <LineBreak/>
                                    The road condition after the race starts will be dictated by factors such as the settings for "Wetness at Race Start" and "Road Wetting Speed." <LineBreak/>
                                    Initial Track Water in %, 1 is 10%, 100 is 100%. 0/-1 is no water on the track.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->initial_retention10</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_InitialRetention10" ValueChanged="iud_InitialRetention10_ValueChanged" Height="20" Maximum="10" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="173,324,11,0" VerticalAlignment="Top"/>

                <Label Name="label_DecisiveWeather" Content="Decisive Weather" Height="28" TabIndex="24" VerticalAlignment="Top" Margin="9,351,118,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Decisive Weather</TextBlock> <LineBreak />
                                    Forced weather on the track which cannot change. If you want a variable weather, use None.<LineBreak/>
                                    <TextBlock FontWeight="Bold">None</TextBlock>: Use for variable weather.<LineBreak/>
                                    <TextBlock FontWeight="Bold">Sunny</TextBlock>: Recommended default. Sunny event.<LineBreak/>
                                    <TextBlock FontWeight="Bold">Rainy</TextBlock>: Rainy event.<LineBreak/>
                                    <TextBlock FontWeight="Bold">Snowy</TextBlock>: Snowy event.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->decisive_weather</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_DecisiveWeather" Height="21" TabIndex="37" VerticalAlignment="Top" SelectionChanged="comboBox_DecisiveWeather_SelectedIndexChanged" Margin="137,354,11,0" />

                <Label Name="label_WeatherProgressionLength" Content="Weather Progress Length" TabIndex="22" Margin="8,380,83,136" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Weather Progression Length</TextBlock> <LineBreak />
                                    Total length in seconds of all weather steps.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_total_sec</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:UShortUpDown Name="iud_WeatherTotalSec" ValueChanged="iud_WeatherTotalSec_ValueChanged" Height="20" Width="66" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="177,384,11,0" VerticalAlignment="Top"/>

                <Label Name="label_WeatherRandomSeed" Content="Seed" Height="27" TabIndex="20" VerticalAlignment="Top"  Margin="133,175,75,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Weather Random Seed</TextBlock> <LineBreak />
                                    Seed if the weather is random.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_random_seed</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_WeatherRandomSeed" ValueChanged="iud_WeatherRandomSeed_ValueChanged" Height="20" Width="61" Maximum="100000" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="177,178,6,0" VerticalAlignment="Top"/>

                <Label Name="label_WeatherTimeProgressionSpeed" Content="Clock Time Speed" Height="30" TabIndex="18" VerticalAlignment="Top" Margin="9,232,95,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Clock Time Speed</TextBlock> <LineBreak />
                                    Choose how quickly time passes during a race. The greater this number is, the faster time passes during a race.<LineBreak/>
                                    Note: This setting is only available for some courses.<LineBreak/>
                                    <LineBreak/>
                                    Multiplier of how fast time progresses.<LineBreak/>
                                    - 1.0 = Real-Time, 60s/1min.<LineBreak/>
                                    - 24 = 2.5s/1min<LineBreak/>
                                    - 60 = 24 Minute day, 1s per minute.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->time_progress_speed</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_TimeProgressSpeed" ValueChanged="iud_TimeProgressSpeed_ValueChanged" Height="20" Width="70" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="168,237,6,0" VerticalAlignment="Top"/>

                <CheckBox Name="checkBox_RandomWeather" Content="Random Weather" Checked="checkBox_RandomWeather_Checked" Unchecked="checkBox_RandomWeather_Checked" Height="19" TabIndex="17" VerticalAlignment="Top" Margin="10,178,115,0">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Random Weather</TextBlock> <LineBreak />
                                    Forces the weather to be random or predetermined.<LineBreak/>
                                    Can be used to make the game continue generating random weather after all preset weather steps are done.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_random</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox Name="checkBox_WeatherPrecSnowOnly" Content="Only Snow" Height="24" TabIndex="16" VerticalAlignment="Top" Margin="160,204,6,0">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Only Snow Precipitation</TextBlock> <LineBreak />
                                    Forces any allowed precipitation to be either rain or snow.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_prec_rain_only</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <CheckBox Name="checkBox_WeatherPrecRainOnly" Content="Only Rain Precipitation" Checked="checkBox_WeatherPrecRainOnly_Checked" Unchecked="checkBox_WeatherPrecRainOnly_Checked" Height="24" TabIndex="15" VerticalAlignment="Top" Margin="10,203,94,0" >
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Only Rain Precipitation</TextBlock> <LineBreak />
                                    Forces any allowed precipitation to be either rain or snow.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_prec_snow_only</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <Label Name="label_WeatherPointNum" Content="Weather Step Count" Height="25" TabIndex="13" VerticalAlignment="Top" Margin="10,407,81,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Weather Step Count</TextBlock> <LineBreak />
                                    How many predetermined weather steps are setup. You shouldn't need to use that, as it will be set by the weather steps.<LineBreak/>
                                    Use "New Weather Data" to set them up, "Weather Progression Length" is the total length of all steps.<LineBreak/>
                                    Unimplemented for GT5.<LineBreak/>
                                    GT5 uses 4 max. GT6 is any amount.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_point_num</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="iud_WeatherPointNum" ValueChanged="iud_WeatherPointNum_ValueChanged" IsEnabled="False" Height="20" Width="66" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="177,412,11,0" VerticalAlignment="Top"/>

                <Label Name="label_WeatherChangeRate" Content="Road Wetting Speed" Height="26" TabIndex="11" VerticalAlignment="Top" Margin="9,262,84,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Weather Changeability</TextBlock> <LineBreak />
                                    Defines the speed at which weather changes during a race. <LineBreak/>
                                    A value of "0" will mean that the weather does not change at all, while higher values will result in increasingly changeable weather.<LineBreak/>
                                    <LineBreak/>
                                    Note: To make it clear, above is the original description, but somewhat misleading. <LineBreak />
                                    If this is set to 0, the track won't get wet even if its raining. 0 for no wet-ability, to 1000 for extremely fast.
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_accel10</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="iud_WeatherAccel10" ValueChanged="iud_WeatherAccel10_ValueChanged" Height="20" Width="70" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="168,266,6,0" VerticalAlignment="Top"/>

                <CheckBox Name="checkBox_WeatherNoWind" Checked="checkBox_WeatherNoWind_Checked" Unchecked="checkBox_WeatherNoWind_Checked" Content="No Wind" Height="19" TabIndex="10" VerticalAlignment="Top" Margin="10,153,133,0">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">No Wind</TextBlock> <LineBreak />
                                    Undocumented.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_no_wind</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_WeatherNoSchedule" Content="No Schedule" Height="24" TabIndex="9" VerticalAlignment="Top" IsChecked="{Binding Path=RaceParameters.WeatherNoSchedule}" Margin="10,122,133,0" >
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">No Schedule</TextBlock> <LineBreak />
                                    Whether or not the weather can vary.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_no_schedule</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>
                <CheckBox Name="checkBox_WeatherNoPrecipitation" Checked="checkBox_WeatherNoPrecipitation_Checked" Unchecked="checkBox_WeatherNoPrecipitation_Checked" Content="No Precipitation" Height="24" TabIndex="8" VerticalAlignment="Top" Margin="122,122,9,0" >
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">No Precipitation</TextBlock> <LineBreak />
                                    Whether or not the weather can progress to rain/snow.<LineBreak/>
                                    To enable 'Realtime Weather', disable this and enable weather_prec_rain/snow_only<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_no_precipitation</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <Label Name="label_MinTemp" Content="Min Temp Diff (in °C)" Height="26" TabIndex="6" VerticalAlignment="Top" Margin="9,64,89,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Min Temp Diff</TextBlock> <LineBreak />
                                    Min temperature difference to the base, affects how fast water can dry (in 2°C increments).<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_min_celsius</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_WeatherMinCelsius" ValueChanged="iud_WeatherMinCelsius_ValueChanged" Height="20" Maximum="7" Minimum="-8" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="168,68,6,0" VerticalAlignment="Top"/>

                <Label Name="label_MaxTemp" Content="Max Temp Diff (in °C)" Height="28" TabIndex="4" VerticalAlignment="Top" Margin="9,92,90,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Max Temp Diff</TextBlock> <LineBreak />
                                    Max temperature difference to the base, affects how fast water can dry (in 2°C increments).<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_max_celsius</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_WeatherMaxCelsius" ValueChanged="iud_WeatherMaxCelsius_ValueChanged" Height="20" Maximum="7" Minimum="-8" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="168,96,6,0" VerticalAlignment="Top"/>

                <Label Name="label_BaseTemp" Content="Base Temperature (in °C)" Height="30" TabIndex="3" VerticalAlignment="Top" Margin="9,39,91,0">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Base Temperature</TextBlock> <LineBreak />
                                    Initial temperature, affects how fast water can dry.<LineBreak/>
                                    Default is 63, If it is set to 63, it will not be specified and the default temperature course will be applied.
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->weather_base_celsius</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_WeatherBaseCelsius" ValueChanged="iud_WeatherBaseCelsius_ValueChanged" Height="20" Maximum="63" Minimum="-64" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="168,41,6,0" VerticalAlignment="Top"/>

                <CheckBox Name="cb_StartTime" Height="24" Width="81" TabIndex="1" HorizontalAlignment="Right" VerticalAlignment="Top" VerticalContentAlignment="Center" Unchecked="cb_StartTime_Checked" Checked="cb_StartTime_Checked"
                                      Content="Event Date" Margin="0,10,159,0">
                    <CheckBox.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Event Date</TextBlock> <LineBreak />
                                    Choose the time of day at which the race takes place (dawn, daytime, night, etc.). This setting can only be changed for some courses. <LineBreak/>
                                    Uncheck for default. Date reflects seasons.<LineBreak/>
                                    Depending on where the track is located, January would have a very early sunset, or late sunrise.<LineBreak/>
                                    It is recommended to just set it to Summer, i.e June or better, use real dates if you are using real IRL events.<LineBreak/>
                                    Most tracks will be fully black if the date and time is incorrect.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">race->date</TextBlock>
                                    </TextBlock>
                    </CheckBox.ToolTip>
                    <CheckBox.Resources>
                        <Style TargetType="{x:Type Path}">
                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                        </Style>
                    </CheckBox.Resources>
                </CheckBox>
                <xctk:DateTimeUpDown Name="date_Date" ValueChanged="date_Date_ValueChanged" IsEnabled="False" Height="22" TabIndex="0" VerticalAlignment="Top" Format="FullDateTime" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="100,12,6,0"/>
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>
