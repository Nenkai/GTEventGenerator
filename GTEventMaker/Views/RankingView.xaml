<UserControl x:Class="GTEventMaker.Views.RankingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GTEventMaker.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="604" d:DesignWidth="1154"
             DataContextChanged="UserControl_DataContextChanged">
    <Grid>
        <GroupBox Header="Ranking Parameters" Margin="10,10,767,251">
            <Grid>
                <Label Content="Ranking Type" Margin="10,10,0,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Width="95">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Ranking Display Type</TextBlock><LineBreak />
                            Available if the event is a Seasonal Event.<LineBreak/>
                            <TextBlock FontWeight="Bold">No Rankings</TextBlock>: Event has no ranking. (Typically used for Race Seasonals) <LineBreak/>
                            <TextBlock FontWeight="Bold">By Best Time</TextBlock>: Rankings by Time (Typically used for Time Trial Seasonals) <LineBreak/>
                            <TextBlock FontWeight="Bold">No Drift Score</TextBlock>: Event has no ranking. (Typically used for Drift Trial seasonals) <LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->type</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_RankingType" SelectionChanged="cb_RankingType_SelectionChanged" Margin="189,12,0,0" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="176"/>

                <CheckBox Name="cb_IsLocal" Content="Is Local" Margin="13,39,0,0" Height="32" VerticalAlignment="Top" HorizontalAlignment="Left" Width="222"
                          Checked="cb_IsLocal_Checked" Unchecked="cb_IsLocal_Checked">
                    <CheckBox.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Is Local</TextBlock><LineBreak />
                            Whether the event's rankings is local only.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->is_local</TextBlock>
                        </TextBlock>
                    </CheckBox.ToolTip>
                </CheckBox>

                <Separator Margin="13,73,0,0" Height="5" VerticalAlignment="Top" HorizontalAlignment="Left" Width="352"/>

                <Label Content="Replay Rank Limit" Margin="10,83,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="222">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Replay Rank Limit</TextBlock><LineBreak />
                            How many replays are stored in terms of ranks. 10 means only top 10 replays are uploaded.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->replay_rank_limit</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="iud_ReplayRankLimit" ValueChanged="iud_ReplayRankLimit_ValueChanged" Margin="189,85,0,0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Height="22" VerticalAlignment="Top" HorizontalAlignment="Left" Width="176" />

                <Label Content="Display Rank Limit" Margin="10,112,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="222">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Display Rank Limit</TextBlock><LineBreak />
                            Max number of displayed rankings.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->display_rank_limit</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="iud_DisplayRankLimit" ValueChanged="iud_DisplayRankLimit_ValueChanged" Margin="189,114,0,0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Height="22" VerticalAlignment="Top" HorizontalAlignment="Left" Width="176" />

                <Separator Margin="13,141,0,0" HorizontalAlignment="Left" Width="352" Height="5" VerticalAlignment="Top"/>

                <Label Content="Board ID" Margin="10,148,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="222">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Board ID</TextBlock> <LineBreak />
                                    Database ID - id which rankings are stored. Should probably match Event ID.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->board_id</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ULongUpDown Name="iud_BoardID" Margin="189,151,0,0" ValueChanged="iud_BoardID_ValueChanged"  BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Width="176" />

                <Separator Margin="13,176,0,0" HorizontalAlignment="Left" Width="352" Height="5" VerticalAlignment="Top"/>

                <Label Content="Registration Type" Margin="10,186,0,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Left" Width="111">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Registration Type</TextBlock><LineBreak />
                            GT6 Only. Whether a special type of registration is necesary.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->registration_type</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_RegistrationType" SelectionChanged="cb_RegistrationType_SelectionChanged" Margin="189,187,0,0" Height="24" VerticalAlignment="Top" HorizontalAlignment="Left" Width="176"/>

                <Label Content="Registration ID" Margin="10,216,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="137">
                    <Label.ToolTip>
                        <TextBlock>
                            <TextBlock FontWeight="Bold" FontSize="14">Registration</TextBlock><LineBreak />
                            Will be passed to UserProfile2.requestSpecialStatus to check if the player can participate.<LineBreak/>
                            <LineBreak/>
                            <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->registration_type</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="iud_RegistrationID" ValueChanged="iud_RegistrationID_ValueChanged" Margin="188,219,0,0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Width="177" />

                <Separator Margin="13,244,0,0" HorizontalAlignment="Left" Width="352" Height="5" VerticalAlignment="Top"/>

                <Label Content="Start Date" Margin="10,251,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="137">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Registration Start Date</TextBlock> <LineBreak />
                                    Ranking registation start date.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->start_date</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:DateTimeUpDown Name="dt_StartDate" ValueChanged="dt_StartDate_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="188,254,0,0" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Width="177"/>

                <Label Content="End Date" Margin="10,278,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="137">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Registration End Date</TextBlock> <LineBreak />
                                    Ranking registation end date.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">ranking->end_date</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:DateTimeUpDown Name="dt_EndDate" ValueChanged="dt_EndDate_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="188,281,0,0" Height="20" VerticalAlignment="Top" HorizontalAlignment="Left" Width="177"/>

            </Grid>

        </GroupBox>

    </Grid>
</UserControl>
