<UserControl x:Class="GTEventMaker.Views.EvalConditionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GTEventMaker.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="604" d:DesignWidth="1154"
             DataContextChanged="UserControl_DataContextChanged">
    <Grid>
        <Grid>
            <GroupBox Header="Game Mode Targets" Height="206" Canvas.Left="10" Canvas.Top="10" Width="278" Margin="10,10,866,0" VerticalAlignment="Top">
                <Grid>
                    <Label Content="Evaluation Type" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="98">
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Evaluation Type</TextBlock> <LineBreak />
                                    Target Type<LineBreak/>
                                    <TextBlock FontWeight="Bold">By Time (in MS)</TextBlock>: Completing the event under a certain time (TIME) <LineBreak/>
                                    <TextBlock FontWeight="Bold">By Drift Score</TextBlock>: Completing the event above a certain score (DRIFT) <LineBreak/>
                                    <TextBlock FontWeight="Bold">By Overtake Count</TextBlock>: Completing the event above a certain overtake count (OVERTAKE) <LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">eval_condition->type (COURSEOUT)</TextBlock>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <ComboBox Name="cb_EvalType" Canvas.Left="113" Canvas.Top="13" SelectionChanged="cb_EvalType_SelectedIndexChanged" Margin="0,15,10,0" HorizontalAlignment="Right" Width="153" Height="19" VerticalAlignment="Top"/>
                    <Separator Margin="10,39,10,0" Canvas.Top="44" Canvas.Left="10" Height="11" VerticalAlignment="Top"/>

                    <Label Content="Gold" HorizontalAlignment="Left" Margin="10,53,0,0" VerticalAlignment="Top" Width="98">
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Gold</TextBlock> <LineBreak />
                                    Gold Score/Time to beat.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">eval_condition->gold</TextBlock>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:IntegerUpDown Name="iud_EvalGold" Minimum="0" Width="142" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,56,10,0"
                                        ValueChanged="iud_EvalGold_ValueChanged"/>

                    <Label Content="Silver" Margin="10,82,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="98">
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Silver</TextBlock> <LineBreak />
                                    Silver Score/Time to beat.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">eval_condition->silver</TextBlock>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:IntegerUpDown Name="iud_EvalSilver" Minimum="0" Width="141" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="124,85,0,0"
                                        ValueChanged="iud_EvalSilver_ValueChanged"/>
                    <Label Content="Bronze" HorizontalAlignment="Left" Margin="10,110,0,0" VerticalAlignment="Top" Width="98">
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Bronze</TextBlock> <LineBreak />
                                    Bronze Score/Time to beat.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">eval_condition->bronze</TextBlock>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:IntegerUpDown Name="iud_EvalBronze" Minimum="0" Width="141" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,113,11,0"
                                        ValueChanged="iud_EvalBronze_ValueChanged"/>

                    <Label Content="Ghost Data Path" HorizontalAlignment="Left" VerticalAlignment="Top" Width="98" Margin="10,139,0,0">
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Ghost Data Path</TextBlock> <LineBreak />
                                    File path for a ghost/replay which represents a time to beat.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">eval_condition->ghost_data_path</TextBlock>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <TextBox x:Name="tb_GhostDataPath" Height="22" Margin="113,142,11,0" TextChanged="tb_GhostDataPath_TextChanged" VerticalAlignment="Top"/>
                </Grid>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>
