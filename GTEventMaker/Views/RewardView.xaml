<UserControl x:Class="GTEventMaker.Views.RewardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GTEventMaker.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="604" d:DesignWidth="1154"
             DataContextChanged="UserControl_DataContextChanged">
    <Grid>
        <GroupBox Height="584" Width="209" Margin="10,0,935,0" VerticalAlignment="Center">
            <GroupBox.Header>
                <TextBlock Text="General Rewards"/>
            </GroupBox.Header>
            <Grid>
                <Button Name="btnCreditRewards" Content="Set Credit Rewards" Height="63" VerticalAlignment="Top" Width="180" Click="btnCreditRewards_Click" Margin="14,10,13,0">
                    <Button.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Credit Rewards</TextBlock> <LineBreak />
                                    All credits rewards for each placement.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">reward->prize_table[]->prize</TextBlock>
                                    </TextBlock>
                    </Button.ToolTip>
                </Button>
                <Separator Width="180" Margin="14,78,13,386"/>
                <Button Name="btnXPRewards" Content="Set XP Rewards (GT5)" Height="63" VerticalAlignment="Top" Width="180" Click="btnXPRewards_Click" Margin="14,98,13,0">
                    <Button.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">XP Rewards</TextBlock> <LineBreak />
                                    Experience Rewards for each ranked position.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">reward->point_table[]->point</TextBlock>
                                    </TextBlock>
                    </Button.ToolTip>
                </Button>
                <Separator Width="180" Margin="14,166,13,298"/>
                <Button Name="btn_StarRewards" Content="Set Star Rewards (GT6)" Height="62" VerticalAlignment="Top" Width="180" Click="btn_StarRewards_Click" Margin="14,186,13,0">
                    <Button.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Star Rewards</TextBlock> <LineBreak />
                                    Star rewards. They also work on non regular folders (i.e Missions).<LineBreak/>
                                    If you are using non regular folders it is recommended to set it to 1 star only, as the event will not show the star progression. <LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">reward->star_table[]->star</TextBlock>
                                    </TextBlock>
                    </Button.ToolTip>
                </Button>

            </Grid>
        </GroupBox>
        <GroupBox Header="Settings" Height="584" Width="320" Margin="224,0,610,0" VerticalAlignment="Center">
            <Grid>
                <Label Content="Prizes only obtainable once after Winning" Margin="29,10,19,508" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Is Once</TextBlock> <LineBreak />
                                    All rewards will be given only once after completing. Use this to allow or disallow prize farming.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">reward->is_once</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <CheckBox IsChecked="{Binding Path=Rewards.IsOnce}" Canvas.Left="282" Canvas.Top="18" Margin="10,8,251,513" />
                <Label Content="All Tier rewards are combined" Canvas.Left="10" Canvas.Top="41" Margin="29,43,67,410" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Prize Type</TextBlock> <LineBreak />
                                    All rewards will be given - if you get gold, you will also get silver and bronze prizes.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">reward->prize_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <CheckBox Margin="10,43,0,481" />
            </Grid>
        </GroupBox>
        <GroupBox Header="Rewards by Placement" Height="305"  Margin="549,10,10,0" VerticalAlignment="Top">
            <Grid>
                <Label Content="Given by" Margin="10,12,327,0" Height="30" VerticalAlignment="Top">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Reward Type</TextBlock> <LineBreak />
                                    Target Type<LineBreak/>
                                    <TextBlock FontWeight="Bold">By Placement Order (1st/2nd/3rd)</TextBlock>: Reward depends on placement<LineBreak/>
                                    <TextBlock FontWeight="Bold">Randomly regardless of placement</TextBlock>: Rewards are given randomly regardless of placement<LineBreak/>
                                    <TextBlock FontWeight="Bold">By Overtake Count</TextBlock>: Completing the event above a certain overtake count (OVERTAKE) <LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">reward->present_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_RewardPlacementType" Canvas.Left="71" Canvas.Top="14" SelectionChanged="cb_RewardPlacementType_SelectionChanged" Margin="266,13,10,0" Height="27" VerticalAlignment="Top"/>

                <Separator Margin="10,42,10,209"/>

                <Label Content="#1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="10,68,539,173"/>
                <Button Name="btn_Present1" Content="Present #1" Margin="54,68,10,173" Click="btn_Present1_Click"/>

                <Label Content="#2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="10,105,539,136"/>
                <Button Name="btn_Present2" Content="Present #2" Margin="54,104,10,136" Click="btn_Present2_Click"/>

                <Label Content="#3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="10,141,539,100"/>
                <Button Name="btn_Present3" Content="Present #3" Margin="54,141,10,100" Click="btn_Present3_Click"/>
            </Grid>
        </GroupBox>
        <GroupBox Header="Participation Rewards" Height="274" Margin="549,320,10,0" VerticalAlignment="Top">
            <Grid>
                <Label Content="Given by" Margin="10,10,329,0" Height="31" VerticalAlignment="Top">
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Participation Present Type</TextBlock> <LineBreak />
                                    How rewards are given depending on event participation<LineBreak/>
                                    <TextBlock FontWeight="Bold">Finishing Event</TextBlock>: Rewards given by finishing the event (FINISH)<LineBreak/>
                                    <TextBlock FontWeight="Bold">All</TextBlock>: Undocumented<LineBreak/>
                                    <TextBlock FontWeight="Bold">Completing One Lap</TextBlock>: Rewards given by completing one lap in the event (LAP)<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">reward->entry_present_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_RewardParticipationType" Canvas.Left="71" Canvas.Top="14" Width="329" SelectionChanged="cb_RewardParticipationType_SelectionChanged" Margin="254,10,10,0" Height="27" VerticalAlignment="Top"/>

                <Separator Margin="10,42,10,178"/>

                <Label Content="#1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="10,68,539,142"/>
                <Button Name="btn_EntryPresent1" Content="Present #1" Margin="54,68,10,142" Click="btn_EntryPresent1_Click"/>

                <Label Content="#2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="10,105,539,105"/>
                <Button Name="btn_EntryPresent2" Content="Present #2" Margin="54,104,10,105" Click="btn_EntryPresent2_Click"/>

                <Label Content="#3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="10,141,539,69"/>
                <Button Name="btn_EntryPresent3" Content="Present #3" Margin="54,141,10,69" Click="btn_EntryPresent3_Click"/>

            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
