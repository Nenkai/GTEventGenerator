<UserControl x:Class="GTEventMaker.Views.EntrySetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GTEventMaker.Views"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d" 
             d:DesignHeight="604" d:DesignWidth="1154"
             DataContextChanged="UserControl_DataContextChanged">
    <Grid>
        <Grid Name="cantabEntries" >
            <GroupBox HorizontalAlignment="Left" Width="581" Margin="10,10,0,10" >
                <GroupBox.Header>
                    <TextBlock Text="Entry Generation"/>
                </GroupBox.Header>
                <Grid>
                    <CheckBox Name="checkBox_RandomCarColor" Content="Random Car Color" Height="25" Width="128" HorizontalAlignment="Left" VerticalContentAlignment="Center" VerticalAlignment="Top" IsChecked="True" Margin="10,251,0,0">
                        <CheckBox.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Generate Random Flag</TextBlock> <LineBreak />
                                    When an Entry is generated, whether it has a random flag, else defaults to PDI.
                                </TextBlock>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <CheckBox Name="checkBox_RandomDriverName" Content="Random Name" IsChecked="True" Height="24" Width="146" HorizontalAlignment="Left" VerticalContentAlignment="Center" VerticalAlignment="Top" Margin="10,220,0,0">
                        <CheckBox.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Random Driver Name</TextBlock> <LineBreak />
                                    When an Entry is generated, whether it has a random name.
                                </TextBlock>
                        </CheckBox.ToolTip>
                    </CheckBox>

                    <CheckBox Name="checkBox_GenerateRandomFlag" Content="Generate Random Flag" IsChecked="True" Height="25" Width="158" HorizontalAlignment="Left" VerticalContentAlignment="Center" VerticalAlignment="Top" Margin="146,220,0,0" >
                        <CheckBox.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Generate Random Flag</TextBlock> <LineBreak />
                                    When an Entry is generated, whether it has a random color, or defaults to the first one.<LineBreak/>
                                </TextBlock>
                        </CheckBox.ToolTip>
                    </CheckBox>

                    <Label Content="to" Height="25" VerticalAlignment="Top" HorizontalContentAlignment="Center"
                                   ToolTip="When an Entry is generated, the maximum acceleration skill it will use to make a random one." Margin="216,155,0,0" HorizontalAlignment="Left" Width="36"/>
                    <xctk:SByteUpDown Name="numericUpDown_AccelSkillMax" Height="20" Width="50" Maximum="100" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="255,158,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                      ValueChanged="numericUpDown_AccelSkillMax_ValueChanged"/>

                    <Label Content="to" Height="25" Width="34" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center"
                                   ToolTip="When an Entry is generated, the maximum starting skill it will use to make a random one. This will also set the default starting skill." Margin="216,183,0,0"/>
                    <xctk:SByteUpDown Name="numericUpDown_StartSkillMax" Height="20" Width="50" Maximum="100" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="255,186,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                      ValueChanged="numericUpDown_StartSkillMax_ValueChanged"/>

                    <Label Content="to" Height="25" Width="36"  HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center"
                                   ToolTip="When an Entry is generated, the minimum brake skill it will use to make a random one. This will also set the default braking skill." Margin="216,127,0,0"/>
                    <xctk:ShortUpDown Name="numericUpDown_BrakeSkillMax" Height="20" Width="50" Maximum="200" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="255,130,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                      ValueChanged="numericUpDown_BrakeSkillMax_ValueChanged"/>
                    <xctk:SByteUpDown Name="numericUpDown_AccelSkillMin" Height="20" Width="50" Value="0" Maximum="100" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="164,158,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                    <Label Content="AI Acceleration Skill" Height="24" Width="140" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,152,0,0" >
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">AI Acceleration Skill</TextBlock> <LineBreak />
                                    If set, upon generation entries will have the specified AI Acceleration Skill.<LineBreak/>
                                    Decides how skilled the entry is at accelerating.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->ai_skill_accelerating</TextBlock>
                                </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:SByteUpDown Name="numericUpDown_StartSkillMin" Height="20" Width="50" Value="0" Maximum="100" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="164,186,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <Label Content="AI Skill Starting" Height="26" Width="136" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,180,0,0" >
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">AI Starting Skill</TextBlock> <LineBreak />
                                    If set, upon generation entries will have the specified AI Starting Skill.<LineBreak/>
                                    Decides how skilled the entry is at starting.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->ai_skill_starting</TextBlock>
                                </TextBlock>
                        </Label.ToolTip>
                    </Label>

                    <Label Content="to" Height="24" Width="36" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center"
                                   ToolTip="When an Entry is generated, the maximum corner skill it will use to make a random one. This will also set the default cornering skill." Margin="216,98,0,0"/>
                    <xctk:ShortUpDown Name="numericUpDown_CornerSkillMax" Height="20" Width="50" Maximum="200" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="255,101,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                      ValueChanged="numericUpDown_CornerSkillMax_ValueChanged"/>
                    <xctk:ShortUpDown Name="numericUpDown_BrakeSkillMin" Height="20" Width="50" Value="0" Maximum="200" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="164,130,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <xctk:ShortUpDown Name="numericUpDown_CornerSkillMin" Height="20" Width="50" Value="0" Maximum="200" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="164,101,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                    <Label Content="AI Braking Skill" Height="30" Width="128" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,126,0,0">
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">AI Braking Skill</TextBlock> <LineBreak />
                                    If set, upon generation entries will have the specified AI Braking Skill.<LineBreak/>
                                    Decides how skilled the entry is at braking. (Default max is 100, can go to 200 - be warned that the AI may not brake if at all)<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->ai_skill_breaking</TextBlock>
                                </TextBlock>
                        </Label.ToolTip>
                    </Label>

                    <Label Content="AI Cornering Skill" Height="26" Width="109" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,94,0,0" >
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">AI Cornering Skill</TextBlock> <LineBreak />
                                    If set, upon generation entries will have the specified AI Cornering Skill.<LineBreak/>
                                    Decides how skilled the entry is at cornering. (Default max is 100, can go to 200 - be warned that the AI may not drive correctly at all)<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->ai_skill_cornering</TextBlock>
                                </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:ShortUpDown Name="numericUpDown_BaseSkillMin" Height="20" Width="50" Value="0" Maximum="200" Minimum="0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="164,73,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                    <Label Content="to" Height="24" Width="36" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center"
                                   ToolTip="When an Entry is generated, the maximum base skill it will use to make a random one. This will also set the default base skill." Margin="216,71,0,0"/>
                    <xctk:ShortUpDown Name="numericUpDown_BaseSkillMax" Height="20" Width="50" Maximum="200" Minimum="0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="255,73,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                      ValueChanged="numericUpDown_BaseSkillMax_ValueChanged"/>
                    <Label Content="to" Width="37" HorizontalAlignment="Left" HorizontalContentAlignment="Center"
                                   ToolTip="When an Entry is generated, the maximum roughness it will use to make a random one. This will also set the default roughness." Margin="215,42,0,0" Height="25" VerticalAlignment="Top"/>

                    <Label Content="AI Roughness" Height="30" Width="140" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,40,0,0" >
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">AI Roughness</TextBlock> <LineBreak />
                                    If set, upon generation entries will have the specified AI Roughness.<LineBreak/>
                                    Affects how AI reacts to other cars. A higher roughness will pretty much ignore cars stopping in front of them. Original events use 0-10.<LineBreak/>
                                    Recommended is something between 0-6. 10 makes AI extremely prone to mistakes when driving near them.
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->ai_roughness</TextBlock>
                                </TextBlock>
                        </Label.ToolTip>
                    </Label>

                    <xctk:SByteUpDown Name="numericUpDown_AIRoughnessMin" Height="20" Width="50" Maximum="10" Value="0" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="164,45,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <xctk:SByteUpDown Name="numericUpDown_AIRoughnessMax" Height="20" Width="50" Maximum="10" Minimum="-1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="255,45,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                      ValueChanged="numericUpDown_AIRoughnessMax_ValueChanged"/>

                    <Label Content="AI Base Skill" Height="25" Width="78" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,68,0,0" >
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">AI Roughness</TextBlock> <LineBreak />
                                    If set, upon generation entries will have the specified AI Skill.<LineBreak/>
                                    General Skill, not much info about<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->ai_roughness</TextBlock>
                                </TextBlock>
                        </Label.ToolTip>
                    </Label>

                    <Label Content="Tire Compound" Width="161" HorizontalAlignment="Left" Margin="9,281,0,232">
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Tire Compound</TextBlock> <LineBreak />
                                    If selected, upon generation entries will use the selected front tyres.<LineBreak/>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>

                    <Label Content="Generation Type" Height="25" Width="99" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0" >
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Generate Type</TextBlock> <LineBreak />
                                    How entries are picked from the entry pool.<LineBreak/>
                                    <TextBlock FontWeight="Bold">- None (fixed entries only)</TextBlock>: Entry Pool won't be used. <TextBlock FontWeight="Bold">Use this when using fixed entries.</TextBlock><LineBreak />
                                    <TextBlock FontWeight="Bold">- Shuffle - Depends on 'Car List'</TextBlock>: Entries are created from the specified 'Car List', then shuffled<LineBreak />
                                    <TextBlock FontWeight="Bold">- One Make - Depends on the player's car</TextBlock>: One Make. Player entry must be specified as a fixed entry<LineBreak />
                                    <TextBlock FontWeight="Bold">- Enemy List - From Enemy Lists</TextBlock>: GT5 Only. Depends on 'Enemy List Type', entries are generated from the enemy files in the textdata folders.<LineBreak />
                                    <TextBlock FontWeight="Bold">- SpecDB - Entries from SpecDB RACE Table</TextBlock>: Depends on 'Race Code'. Entries will be created from the RACE row in the SpecDB based on it.<LineBreak />
                                    <TextBlock FontWeight="Bold">- Order - Depends on 'Car List'</TextBlock>: Entries are created from the specified car list, in order<LineBreak />
                                    <TextBlock FontWeight="Bold">- Pick generated entries and shuffle</TextBlock>: Entries will randomly be picked from the Entry Pool, depending on 'Nb. Of Entries to Generate'.<LineBreak />
                                    <TextBlock FontWeight="Bold">- Pick generated entries by Order</TextBlock>: Entries will randomly be picked from the Entry Pool by order, depending on 'Nb. Of Entries to Generate'.<LineBreak />
                                    <LineBreak />
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->generate_type</TextBlock>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <ComboBox Name="comboBox_entryGenerateType" Height="21" Width="195" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="comboBox_entryGenerateType_SelectionChanged" Margin="109,14,0,0" />

                    <Label Content="Enemy Sort Type" Height="25" VerticalAlignment="Top"  Margin="11,313,452,0" >
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Enemy Sort Type</TextBlock> <LineBreak />
                                    The order in which the picked entries that the game picked will appear on the starting Grid Type. <LineBreak/>
                                    <TextBlock FontWeight="Bold">None Sorting</TextBlock>: Depends on the order of entries.<LineBreak />
                                    <TextBlock FontWeight="Bold">Sort selected entries by Ascending PP</TextBlock>: Entries selected by the game will be sorted on the grid by Ascending PP.<LineBreak />
                                    <TextBlock FontWeight="Bold">Sort selected entries by Descending PP</TextBlock>: Entries selected by the game will be sorted on the grid by Descending PP.<LineBreak />
                                    <LineBreak />
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->enemy_sort_type</TextBlock>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <ComboBox Name="comboBox_EntrySortType" Height="21" Width="158" HorizontalAlignment="Left" VerticalAlignment="Top" SelectionChanged="comboBox_EntrySortType_SelectionChanged" Margin="147,316,0,0" />

                    <Label Content="Dist. Between Cars for Rolling Start (in m)" Height="29" Width="260" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,343,0,0" >
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Dist. Between Cars for a Rolling Start</TextBlock> <LineBreak />
                                    Distance between cars for a rolling start if chosen, in meters.<LineBreak/>
                                    0 for default, game uses 50-100 depending on how fast cars are. Shouldn't be more than 300.<LineBreak/>
                                    <LineBreak />
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->gap_for_start_rolling_distance</TextBlock>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:ShortUpDown Name="numericUpDown_GapForRollingDistance" ValueChanged="numericUpDown_GapForRollingDistance_ValueChanged" Height="20" Width="64" Maximum="2000" Minimum="0" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="241,347,0,0" VerticalAlignment="Top" HorizontalAlignment="Left"/>

                    <Label Content="Player Position" Width="109" Margin="10,402,0,0" Height="27" VerticalAlignment="Top" HorizontalAlignment="Left">
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Player Position</TextBlock> <LineBreak />
                                    The position where the player will start the race.<LineBreak/>
                                    <LineBreak />
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->player_pos</TextBlock>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <Slider Name="sl_EntryPlayerPos" AutoToolTipPrecision="1" AutoToolTipPlacement="BottomRight" Minimum="1" TickFrequency="1" TickPlacement="BottomRight" IsSnapToTickEnabled="True" ValueChanged="sl_EntryPlayerPos_ValueChanged" Margin="119,402,0,0" Height="31" VerticalAlignment="Top" HorizontalAlignment="Left" Width="161"/>
                    <Label Name="label_PlayerPos" HorizontalContentAlignment="Center" Margin="0,403,265,0" HorizontalAlignment="Right" Width="38" Height="26" VerticalAlignment="Top" >#1</Label>

                    <Label Content="Nb. Of Entries to Generate" Margin="10,372,0,0" Height="30" VerticalAlignment="Top" HorizontalAlignment="Left" Width="153">
                        <Label.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Number Of Entries to Generate</TextBlock> <LineBreak />
                                    If using the entry pool generation, the amount of entries to pick from it.<LineBreak/>
                                    <LineBreak />
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->entry_num</TextBlock>
                                    </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <Slider Name="sl_EntryCount" Minimum="0"
                                    TickFrequency="1" AutoToolTipPrecision="1" AutoToolTipPlacement="BottomRight" TickPlacement="BottomRight" Maximum="16" IsSnapToTickEnabled="True" ValueChanged="slider_EntryCount_ValueChanged" Margin="163,371,0,0" Height="31" VerticalAlignment="Top" HorizontalAlignment="Left" Width="117"/>
                    <Label Name="label_EntryCount" Height="26" Width="29" HorizontalAlignment="Right" HorizontalContentAlignment="Center" VerticalAlignment="Top" Margin="0,372,270,0" >1</Label>

                    <ComboBox Name="comboBox_EntryGenTyreComp" Height="20" Width="158" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="147,285,0,0" >
                        <ComboBoxItem Content="Use Car Defaults" HorizontalAlignment="Left" Width="156"/>
                    </ComboBox>
                    <GroupBox Name="grp_GeneratedEntryPool" IsEnabled="False" Margin="314,14,0,7" Header="Generated Entry Pool" HorizontalAlignment="Left"  Width="258" >
                        <GroupBox.ToolTip>
                            <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Generated Entry Pool</TextBlock> <LineBreak />
                                    Entries here will have a chance of appearing in the event. If you have 64 different entries with different cars, the cars picked will be random.<LineBreak/>
                                    You can have as many as you want, amount of cars generated depends on 'Nb. Of Entries to Generate'.<LineBreak/>
                                    If you have less than 'Nb. Of Entries to Generate', the cars will always appear.<LineBreak/>
                                    To use this, Generation Type has to be 'Pick generated entries and shuffle' or 'Pick generated entries by order'.<LineBreak/>
                                    Note: You cannot have both fixed and generated entries.<LineBreak/>

                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_generate->entry_base[]</TextBlock>
                                    </TextBlock>
                        </GroupBox.ToolTip>

                        <Grid>
                            <Button Name="button_RemoveEntryBase" IsEnabled="False" Height="24" Width="111" VerticalAlignment="Bottom" Click="button_EditAI_Clicked" Margin="10,0,143,10">Edit Entry</Button>
                            <Button Name="button_EditEntryBase" IsEnabled="False" Height="24" Width="111" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="button_RemoveAI_Clicked" Margin="0,0,10,10">Remove Entries</Button>
                            <ListBox Name="listBox_EntryBases" DisplayMemberPath="Name" SelectionMode="Multiple" Margin="10,12,0,39" HorizontalAlignment="Left" Width="239"/>
                        </Grid>
                    </GroupBox>

                </Grid>
            </GroupBox>

            <GroupBox Margin="596,10,263,0" VerticalAlignment="Top" Height="348">
                <GroupBox.Header>
                    <TextBlock Text="Car Picker"/>
                </GroupBox.Header>
                <Grid>
                    <Button Name="button_GenerateEntryBase" Content="⬅️ Add to Generate Pool" Height="20" VerticalAlignment="Bottom" Click="button_GenerateEntryBase_Clicked" 
                                    ToolTip="Adds an Entry to the entry pool" Margin="10,0,142,10" />
                    <Button Name="button_GenerateFixedEntry" Height="20" Width="127" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="button_GenerateFixedEntry_Clicked" 
                                    ToolTip="Add as Fixed Entry" Margin="0,0,10,10" >⬇️ Add as Fixed Entry</Button>
                    <ComboBox Name="comboBox_AIManifacturerList" Height="21" VerticalAlignment="Top"  SelectionChanged="comboBox_AIManifacturerList_SelectionChanged" Margin="10,10,10,0" />
                    <ListBox Name="listBox_AICarList" Margin="10,36,10,35" />
                </Grid>
            </GroupBox>

            <GroupBox Margin="596,363,263,10" Header="Fixed Entries" >
                <GroupBox.ToolTip>
                    <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Fixed Entries</TextBlock> <LineBreak />
                                    Entries here will always appear in the event.<LineBreak/>
                                    Note: You cannot have both fixed and generated entries.<LineBreak/>
                                    Note: Having fixed entries means the player must also use a rented car.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_set->entry[]</TextBlock>
                                    </TextBlock>
                </GroupBox.ToolTip>
                <Grid >
                    <Button Name="button_EditFixedEntry" IsEnabled="False" Height="24" Width="111" HorizontalAlignment="Left" VerticalAlignment="Bottom" Click="button_EditFixedEntry_Clicked" Margin="10,0,0,10">Edit Entry</Button>
                    <Button Name="button_RemoveFixedEntry" IsEnabled="False" Height="24" Width="111" HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="button_RemoveFixedAI_Clicked" Margin="0,0,10,10">Remove Entries</Button>
                    <ListBox Name="listBox_FixedEntries" DisplayMemberPath="Name" Margin="10,10,10,39"  SelectionMode="Multiple"/>
                </Grid>
            </GroupBox>

            <GroupBox Name="grp_CarList" IsEnabled="False" Margin="896,10,10,10" Header="Car List" >
                <GroupBox.ToolTip>
                    <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Car List</TextBlock> <LineBreak />
                                    This is the car list that will be used when Generate Type is set to 'Order' or 'Shuffle'.<LineBreak/>
                                    Each entry has to be a car label from GENERIC_CAR or ENEMY_CARS.
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_set->entry_generate->cars</TextBlock>
                                    </TextBlock>
                </GroupBox.ToolTip>
                <Grid>
                    <ListBox Name="lb_CarList" Margin="10,10,10,66" SelectionMode="Multiple"/>
                    <TextBox Name="tb_CarListTextBox" Margin="10,0,50,38" Height="23" VerticalAlignment="Bottom"/>
                    <Button Name="btn_AddToCarList" Content="Add" Margin="201,0,10,38" Click="btn_AddToCarList_Click" Height="23" VerticalAlignment="Bottom"/>
                    <Button Name="btn_RemoveFromCarList" Content="Remove Car(s)" Margin="10,0,10,10" Click="btn_RemoveFromCarList_Click" Height="23" VerticalAlignment="Bottom"/>
                </Grid>
            </GroupBox>

        </Grid>
    </Grid>
</UserControl>
