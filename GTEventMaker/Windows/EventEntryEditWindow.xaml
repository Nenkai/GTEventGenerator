<Window x:Class="GTEventMaker.EventEntryEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:GTEventMaker"
        mc:Ignorable="d"
        Title="Editing Fixed Entry" Height="470" Width="663" WindowStartupLocation="CenterOwner">
    <Grid Background="#262626">
        <GroupBox Header="Common Entry Settings" Height="199" Margin="298,10,10,0" VerticalAlignment="Top">
            <Grid>
                <Label Content="Initial V Coord" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Initial V Coord</TextBlock> <LineBreak />
                           Position in meters in the track the entry will start.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->initial_position</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_InitialVCoord" ValueChanged="iud_InitialVCoord_ValueChanged" Margin="148,12,10,0" Height="22" Minimum="-1" Maximum="99999" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" VerticalAlignment="Top"/>

                <Label Content="Initial Velocity (km/h)" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top" Width="133">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Initial Velocity</TextBlock> <LineBreak />
                           The speed in km/h the entry will start.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->initial_velocity</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_InitialVelocity" ValueChanged="iud_InitialVelocity_ValueChanged" Margin="148,43,10,0" Height="22" Minimum="-1" Maximum="1000" UpdateValueOnEnterKey="True" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" VerticalAlignment="Top"/>

                <Label Content="Delay (in Seconds)" HorizontalAlignment="Left" Margin="10,69,0,0" VerticalAlignment="Top" Width="108">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Delay</TextBlock> <LineBreak />
                           How many seconds after '3, 2, 1' this entry will start.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->delay</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_Delay" ValueChanged="iud_Delay_ValueChanged" Margin="148,73,10,0" Height="22" Minimum="-1" Maximum="999999" UpdateValueOnEnterKey="True" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" VerticalAlignment="Top"/>

                <Label Content="Car Color Index" HorizontalAlignment="Left" Margin="10,100,0,0" VerticalAlignment="Top" Width="108">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Car Color Index</TextBlock> <LineBreak />
                           Index of the car's preset color (first in dealership = 0).<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->car->color</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_CarColorIndex" Margin="148,104,10,0" Minimum="0" Height="22" UpdateValueOnEnterKey="True" ValueChanged="iud_CarColorIndex_ValueChanged" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" VerticalAlignment="Top"/>

                <Label Name="label_StartingType" Content="Starting Type" Height="28" VerticalAlignment="Top" Margin="10,131,249,0" >
                    <Label.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Starting Type</TextBlock> <LineBreak />
                                    Choose how the race will start. A grid start takes place from a standstill. <LineBreak/>
                                    <LineBreak />
                                    - <TextBlock FontWeight="Bold">Grid</TextBlock>: Traditional Grid Standstill Start (GRID)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">For Time Trial</TextBlock>: Starts behind the start line (automatically sets the position for you unless custom via Initial V Coord) (ATTACK)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling Start (Start Line)</TextBlock>: Starts while the cars are moving, Starts after crossing the Start Line (ROLLING)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling (Same Accel. as Own Car)</TextBlock>: Rolling with custom vstart with rolling_start_v (ROLLING2) <LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling (Define Start Time)</TextBlock>: Rolling with custom time to start (ROLLING3)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling (Define Start and Accel)</TextBlock>: Rolling with custom Entry Start Time and Entry Acceleration (ROLLING_NOLIMIT)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Standing (Set Coordinates)</TextBlock>: Standing Start, with custom entry start coordinates (STANDING)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Double-File Rolling (Left)</TextBlock>: Rolling start takes place while the cars are moving in two columns, Cars on the Left (ROLLING_L)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Double-File Rolling (Right)</TextBlock>: Same as above, Cars on the Right (ROLLING_R)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Pit Start</TextBlock>: Starting at Pits (PIT)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">PITWORK</TextBlock>: Undocumented (Unused?)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Same Grid (collisions OFF)</TextBlock>: No info (SAME_GRID)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Dispersed</TextBlock>: No info<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Drift Position (Standing)</TextBlock>: Take drift sector information from .cinf/menudb (COURSEINFO)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Drift Position (Rolling)</TextBlock>: Same as above but rolling (COURSEINFO_ROLLING)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling Start - Dbl. File, Left Ahead</TextBlock>: No info (ROLLING_DL)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">Rolling Start - Dbl. File, Right Ahead</TextBlock>: No info (ROLLING_DR)<LineBreak/>
                                    - <TextBlock FontWeight="Bold">FREE</TextBlock>: No info<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>:<TextBlock FontStyle="Italic">race->start_type</TextBlock>
                                    </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="comboBox_StartingType" Height="22" VerticalAlignment="Top" SelectionChanged="comboBox_StartingType_SelectedIndexChanged" Margin="109,134,10,0" />
            </Grid>
        </GroupBox>
        <GroupBox Name="grp_AIParameters" Header="AI Parameters" Margin="10,0,0,0" Height="429" VerticalAlignment="Center" HorizontalAlignment="Left" Width="283">
            <Grid>
                <Label Content="Driver Name" HorizontalAlignment="Left" Margin="10,8,0,0" VerticalAlignment="Top" Width="92">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Driver Name</TextBlock> <LineBreak />
                           Name of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->driver_name</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <Label Content="Driver Country" HorizontalAlignment="Left" Margin="10,36,0,0" VerticalAlignment="Top" Width="92">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Driver Country</TextBlock> <LineBreak />
                           Country of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->driver_region</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <TextBox Name="tb_DriverName" TextChanged="tb_DriverName_TextChanged" HorizontalAlignment="Left" Height="22" Margin="122,12,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="131"/>
                <TextBox Name="tb_DriverCountry" TextChanged="tb_DriverCountry_TextChanged" HorizontalAlignment="Left" Height="22" Margin="122,40,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="131"/>

                <Label Content="Race Class ID" HorizontalAlignment="Left" Margin="11,67,0,0" VerticalAlignment="Top" Width="92">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Race Class ID</TextBlock> <LineBreak />
                           Sets the car class for this car.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->race_class_id</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="iud_RaceClassID" ValueChanged="iud_RaceClassID_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="124,70,0,0" Height="20" Width="130" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Proxy Driver Model" HorizontalAlignment="Left" Margin="11,94,0,0" VerticalAlignment="Top" Width="115">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Proxy Driver Model</TextBlock> <LineBreak />
                           Mostly unknown, sets the proxy driver model to use. Mostly used in GT5, for vettel, loeb events.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->proxy_driver_model</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_ProxyDriverModel" ValueChanged="iud_ProxyDriverModel_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="124,97,0,0" Minimum="-1" Height="20" Width="130" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Separator Margin="10,125,10,260"/>

                <Label Content="Cornering Skill" HorizontalAlignment="Left" Margin="11,138,0,0" VerticalAlignment="Top" Width="92">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Cornering Skill</TextBlock> <LineBreak />
                           Cornering Skill of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->ai_skill_cornering</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="iud_CorneringSkill" ValueChanged="iud_CorneringSkill_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="123,141,0,0" Height="20" Width="130" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Braking Skill" HorizontalAlignment="Left" Margin="11,165,0,0" VerticalAlignment="Top" Width="92">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Cornering Skill</TextBlock> <LineBreak />
                           Braking Skill of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->ai_skill_breaking - yes, this typo is intentional</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="iud_BrakingSkill" ValueChanged="iud_BrakingSkill_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="123,168,0,0" Height="20" Width="130" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Acceleration Skill" HorizontalAlignment="Left" Margin="11,192,0,0" VerticalAlignment="Top" Width="108">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Accelerating Skill</TextBlock> <LineBreak />
                           Acceleration Skill of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->ai_skill_accelerating</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_AccelSkill" ValueChanged="iud_AccelSkill_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="123,195,0,0" Height="20" Width="130" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Starting Skill" HorizontalAlignment="Left" Margin="11,218,0,0" VerticalAlignment="Top" Width="108">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Starting Skill</TextBlock> <LineBreak />
                           Starting Skill of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->ai_skill_starting</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_StartingSkill" ValueChanged="iud_StartingSkill_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="123,221,0,0" Height="20" Width="130" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Roughness" HorizontalAlignment="Left" Margin="11,245,0,0" VerticalAlignment="Top" Width="107">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Roughness</TextBlock> <LineBreak />
                           Roughness of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->ai_roughness</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_Roughness" ValueChanged="iud_Roughness_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="122,248,0,0" Height="20" Width="131" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

            </Grid>
        </GroupBox>

        <GroupBox Header="Commands" Margin="298,214,10,10">
            <Grid>

                <Button x:Name="btn_CarSettings" IsEnabled="False" Content="(TODO) Car Parameter Settings" Margin="10,5,10,0" VerticalAlignment="Top" Height="36" Click="btn_CarSettings_Click">
                    <Button.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Car Parameter Settings</TextBlock> <LineBreak />
                                    Edits the car parameter for this entry.<LineBreak/>
                                    Allows further settings.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->car_parameter</TextBlock>
                                </TextBlock>
                    </Button.ToolTip>
                </Button>
                <Button x:Name="btn_EntryBaseEdit" Content="Edit Entry Base (GT6)" Margin="10,46,10,0" VerticalAlignment="Top" Height="36" Click="btn_EntryBaseEdit_Click">
                    <Button.ToolTip>
                        <TextBlock>
                                    <TextBlock FontWeight="Bold" FontSize="14">Entry Base</TextBlock> <LineBreak />
                                    Edits the entry base for this entry (GT6 only).<LineBreak/>
                                    Allows further settings.<LineBreak/>
                                    <LineBreak/>
                                    <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry->entry_base</TextBlock>
                                </TextBlock>
                    </Button.ToolTip>
                </Button>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
