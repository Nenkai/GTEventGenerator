<Window x:Class="GTEventMaker.PresentPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:GTEventMaker"
        mc:Ignorable="d"
        Title="Present Selection" Height="490.004" Width="839.763"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterOwner">

    <Grid Background="#262626">
        <GroupBox Margin="10,10,0,10" Header="Parameters" HorizontalAlignment="Left" Width="262">
            <Grid>
                <Label Content="Type ID" Margin="10,10,0,0" Height="31" VerticalAlignment="Top" HorizontalAlignment="Left" Width="66"/>
                <ComboBox Name="cb_TypeID" Margin="81,10,10,0" Height="28" VerticalAlignment="Top" SelectionChanged="cb_TypeID_SelectionChanged"/>

                <Label Content="Category" Margin="10,43,0,0" Height="31" VerticalAlignment="Top" HorizontalAlignment="Left" Width="66"/>
                <ComboBox Name="cb_Category" Margin="81,44,10,0" Height="28" VerticalAlignment="Top" SelectionChanged="cb_Category_SelectionChanged"/>

                <Label Content="Argument 1" Margin="9,76,0,0" Height="31" VerticalAlignment="Top" HorizontalAlignment="Left" Width="80"/>
                <xctk:IntegerUpDown Name="iud_Arg1" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="94,79,10,0" ValueChanged="iud_Arg1_ValueChanged" Height="23" VerticalAlignment="Top"/>

                <Label Content="Argument 2" Margin="9,107,0,0" Height="31" VerticalAlignment="Top" HorizontalAlignment="Left" Width="80"/>
                <xctk:IntegerUpDown Name="iud_Arg2" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="94,110,10,0" ValueChanged="iud_Arg2_ValueChanged" Height="23" VerticalAlignment="Top"/>

                <Label Content="Argument 3" Margin="9,138,0,0" Height="31" VerticalAlignment="Top" HorizontalAlignment="Left" Width="80"/>
                <xctk:IntegerUpDown Name="iud_Arg3" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="94,141,10,0" ValueChanged="iud_Arg3_ValueChanged" Height="23" VerticalAlignment="Top"/>

                <Label Content="Argument 4" Margin="9,170,0,0" Height="31" VerticalAlignment="Top" HorizontalAlignment="Left" Width="80"/>
                <xctk:IntegerUpDown Name="iud_Arg4" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="94,173,10,0" ValueChanged="iud_Arg4_ValueChanged" Height="23" VerticalAlignment="Top"/>

                <Label Content="F Name" Margin="10,205,0,0" Height="31" VerticalAlignment="Top" HorizontalAlignment="Left" Width="80"/>
                <TextBox Name="tb_FName" Margin="94,206,10,0" Height="23" VerticalAlignment="Top" TextChanged="tb_FName_TextChanged" />

                <Button Name="btn_EditPresentCarParameter" IsEnabled="False" Content="Edit Car Parameter" Canvas.Left="204" Canvas.Top="359" Click="btn_EditPresentCarParameter_Click" Height="26" Margin="130,0,10,10" VerticalAlignment="Bottom"/>

            </Grid>
        </GroupBox>
        <GroupBox Header="Car Present" HorizontalAlignment="Left" Margin="277,10,0,10" Width="294">
            <Grid>
                <ComboBox Name="cb_Manufacturers" SelectionChanged="cb_Manufacturers_SelectionChanged" Canvas.Left="10" Canvas.Top="10" Margin="10,10,10,0" Height="26" VerticalAlignment="Top"/>
                <ListBox Name="lv_CarList" Canvas.Left="10" Canvas.Top="37" Margin="10,41,10,41"/>
                <Button Name="btn_SelectCar" Content="Select Car Present" Canvas.Left="10" Canvas.Top="328" Click="btn_SelectCar_Click" Height="26" Margin="10,0,10,10" VerticalAlignment="Bottom"/>
            </Grid>
        </GroupBox>

        <GroupBox Header="Paint Present" Margin="576,10,10,10">
            <Grid>
                <TextBox Name="tb_PaintSearcher" Canvas.Left="10" Canvas.Top="10" Margin="10,13,79,0" Height="20" VerticalAlignment="Top"/>
                <ListBox Name="lv_PaintList" Canvas.Left="10" Canvas.Top="37" Margin="10,41,10,42">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Rectangle Fill="{Binding Color}" Visibility="Visible" Width="16" Height="16" Stroke="Gray"  HorizontalAlignment="Stretch" VerticalAlignment="Center" Stretch="UniformToFill"/>
                                <TextBlock Text="{Binding Path=PaintName}" Padding="5 0 0 0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Name="btn_PaintSearch" Content="Search" Canvas.Left="178" Canvas.Top="10" Click="btn_PaintSearch_Click" Margin="178,13,10,0" Height="20" VerticalAlignment="Top"/>
                <Button Name="btn_SelectPaint" Content="Select Paint" Canvas.Left="10" Canvas.Top="353" Click="btn_SelectPaint_Click" Height="27" Margin="10,0,10,10" VerticalAlignment="Bottom"/>
            </Grid>
        </GroupBox>

    </Grid>
</Window>
