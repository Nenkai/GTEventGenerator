<Window x:Class="GTEventMaker.EventEntryBaseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GTEventMaker"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Entry Base Edit Window" Height="602.494" Width="730" WindowStartupLocation="CenterOwner" >
    <Grid Background="#262626">
        <GroupBox Name="grp_AIParameters" Header="Entry Base Parameters" Margin="10,10,0,0" Height="370" VerticalAlignment="Top" HorizontalAlignment="Left" Width="265">
            <Grid>
                <Label Content="Driver Name" HorizontalAlignment="Left" Margin="11,5,0,0" VerticalAlignment="Top" Width="92">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Driver Name</TextBlock> <LineBreak />
                           Name of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->driver_name</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <Label Content="Driver Country" HorizontalAlignment="Left" Margin="11,32,0,0" VerticalAlignment="Top" Width="92">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Driver Country</TextBlock> <LineBreak />
                           Country of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->driver_region</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <TextBox Name="tb_DriverName" TextChanged="tb_DriverName_TextChanged" HorizontalAlignment="Left" Height="22" Margin="123,8,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="131"/>
                <TextBox Name="tb_DriverCountry" TextChanged="tb_DriverCountry_TextChanged" HorizontalAlignment="Left" Height="22" Margin="123,36,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="131"/>

                <Label Content="Race Class ID" HorizontalAlignment="Left" Margin="11,59,0,0" VerticalAlignment="Top" Width="92">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Race Class ID</TextBlock> <LineBreak />
                           Sets the car class.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->race_class_id</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="iud_RaceClassID" ValueChanged="iud_RaceClassID_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="124,62,0,0" Height="20" Width="130" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Proxy Driver Model" HorizontalAlignment="Left" Margin="11,85,0,0" VerticalAlignment="Top" Width="115">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Proxy Driver Model</TextBlock> <LineBreak />
                           Mostly unknown, sets the proxy driver model to use. Mostly used in GT5, for vettel, loeb events.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->proxy_driver_model</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_ProxyDriverModel" ValueChanged="iud_ProxyDriverModel_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="124,89,0,0" Minimum="-1" Height="20" Width="130" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Separator Margin="10,122,9,0" Height="1" VerticalAlignment="Top"/>

                <Label Content="Cornering Skill" HorizontalAlignment="Left" Margin="11,130,0,0" VerticalAlignment="Top" Width="92">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Cornering Skill</TextBlock> <LineBreak />
                           Cornering Skill of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->ai_skill_cornering</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="iud_CorneringSkill" ValueChanged="iud_CorneringSkill_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="125,133,0,0" Height="20" Width="129" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Braking Skill" HorizontalAlignment="Left" Margin="11,0,0,0" VerticalAlignment="Center" Width="92">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Cornering Skill</TextBlock> <LineBreak />
                           Braking Skill of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->ai_skill_breaking - yes, this typo is intentional</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="iud_BrakingSkill" ValueChanged="iud_BrakingSkill_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="125,0,0,0" Height="20" Width="129" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Acceleration Skill" HorizontalAlignment="Left" Margin="11,183,0,0" VerticalAlignment="Top" Width="108">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Accelerating Skill</TextBlock> <LineBreak />
                           Acceleration Skill of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->ai_skill_accelerating</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_AccelSkill" ValueChanged="iud_AccelSkill_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="125,186,0,0" Height="20" Width="129" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Starting Skill" HorizontalAlignment="Left" Margin="11,210,0,0" VerticalAlignment="Top" Width="108">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Starting Skill</TextBlock> <LineBreak />
                           Starting Skill of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->ai_skill_starting</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_StartingSkill" ValueChanged="iud_StartingSkill_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="125,213,0,0" Height="20" Width="129" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Roughness" HorizontalAlignment="Left" Margin="11,238,0,0" VerticalAlignment="Top" Width="108">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Roughness</TextBlock> <LineBreak />
                           Roughness of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->ai_roughness</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_Roughness" ValueChanged="iud_Roughness_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="125,241,0,0" Height="20" Width="129" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Reaction" HorizontalAlignment="Left" Margin="11,266,0,0" VerticalAlignment="Top" Width="108">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Reaction</TextBlock> <LineBreak />
                           Reaction of this AI entry.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->ai_reaction</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="iud_Reaction" ValueChanged="iud_Reaction_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="125,269,0,0" Height="20" Width="129" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

            </Grid>
        </GroupBox>

        <GroupBox Header="Car Settings" Margin="280,10,0,10" HorizontalAlignment="Left" Width="437">
            <Grid>
                <Label Content="Engine Tuning Stage" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Engine Tuning Stage</TextBlock> <LineBreak />
                           Sets the car's engine stage.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->engine_na_tune_stage</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_EngineStage" HorizontalAlignment="Left" Margin="134,14,0,0" VerticalAlignment="Top" Width="281" SelectionChanged="cb_EngineStage_SelectionChanged"/>

                <Label Content="Turbo" HorizontalAlignment="Left" Margin="10,41,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Turbo</TextBlock> <LineBreak />
                           Sets the car's turbo stage.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->engine_turbo_kit</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_Turbo" HorizontalAlignment="Left" Margin="134,44,0,0" VerticalAlignment="Top" Width="281" SelectionChanged="cb_Turbo_SelectionChanged"/>

                <Label Content="Computer" HorizontalAlignment="Left" Margin="10,72,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Computer</TextBlock> <LineBreak />
                           Sets the car's computer.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->engine_computer</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_Computer" HorizontalAlignment="Left" Margin="134,76,0,0" VerticalAlignment="Top" Width="281" SelectionChanged="cb_Computer_SelectionChanged"/>

                <Label Content="Suspension" HorizontalAlignment="Left" Margin="10,103,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Suspension</TextBlock> <LineBreak />
                           Sets the car's suspension.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->suspension</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_Suspension" HorizontalAlignment="Left" Margin="134,107,0,0" VerticalAlignment="Top" Width="281" SelectionChanged="cb_Suspension_SelectionChanged"/>

                <Label Content="Transmission" HorizontalAlignment="Left" Margin="10,134,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Transmission</TextBlock> <LineBreak />
                           Sets the car's transmission.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->transmission</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_Transmission" HorizontalAlignment="Left" Margin="134,138,0,0" VerticalAlignment="Top" Width="281" SelectionChanged="cb_Transmission_SelectionChanged"/>

                <Label Content="Exhaust" HorizontalAlignment="Left" Margin="10,165,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Exhaust</TextBlock> <LineBreak />
                           Sets the car's exhaust.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->muffler</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_Exhaust" HorizontalAlignment="Left" Margin="134,169,0,0" VerticalAlignment="Top" Width="281" SelectionChanged="cb_Exhaust_SelectionChanged"/>

                <Label Content="Max Gear Speed" HorizontalAlignment="Left" Margin="10,196,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Max Gear Speed</TextBlock> <LineBreak />
                           Set the max speed (in km/h) for the gears. May be limited depending on the car.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->gear_max_speed</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_GearMaxSpeed" ValueChanged="iud_GearMaxSpeed_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="114,200,0,0" Height="20" Width="77" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Power Limiter" HorizontalAlignment="Left" Margin="234,200,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Power Limiter</TextBlock> <LineBreak />
                           Sets the car's power limiter restriction. May conflict or override max gear speed.<LineBreak/>
                           10 = 1%. 1000 = 100%.<LineBreak/>
                           Default is 1000.
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->power_limiter</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_PowerLimiter" ValueChanged="iud_PowerLimiter_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="346,203,0,0" Height="20" Width="69" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Ballast Weight" HorizontalAlignment="Left" Margin="11,261,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Ballast Weight</TextBlock> <LineBreak />
                           Sets the car's ballast weight. (Normally 0-200).<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->ballast_weight</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ByteUpDown Name="iud_BallastWeight" ValueChanged="iud_BallastWeight_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="114,264,0,0" Height="20" Width="77" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Position" HorizontalAlignment="Left" Margin="234,262,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Ballast Position</TextBlock> <LineBreak />
                           Sets the car's ballast position. (Normally -50-50).<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->ballast_position</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <Slider Name="slider_BallastPosition" ValueChanged="slider_BallastPosition_ValueChanged" HorizontalAlignment="Left" Margin="292,265,0,0" VerticalAlignment="Top" Width="123" Minimum="-128" Maximum="127"/>

                <Label Content="Downforce Front" HorizontalAlignment="Left" Margin="10,227,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Downforce Front</TextBlock> <LineBreak />
                           Sets the car's front downforce.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->downforce_f</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_DownforceFront" ValueChanged="iud_DownforceFront_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="114,231,0,0" Height="20" Width="77" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Downforce Rear" HorizontalAlignment="Left" Margin="234,231,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Downforce Front</TextBlock> <LineBreak />
                           Sets the car's front downforce.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->downforce_r</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_DownforceRear" ValueChanged="iud_DownforceRear_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="346,234,0,0" Height="20" Width="69" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Body Paint ID" HorizontalAlignment="Left" Margin="10,292,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Body Paint ID</TextBlock> <LineBreak />
                           Custom paint ID, AllPaintID from SpecDB in the VARIATION table. overrides car color index.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->paint_id</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:ShortUpDown Name="iud_BodyPaintID" ValueChanged="iud_BodyPaintID_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="114,295,0,0" Height="20" Width="77" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Wheel Paint ID" HorizontalAlignment="Left" Margin="234,293,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Wheel Paint ID</TextBlock> <LineBreak />
                           Custom wheel paint ID, AllPaintID from SpecDB in the VARIATION table.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->wheel_color</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_WheelPaintID" ValueChanged="iud_WheelPaintID_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="345,295,0,0" Height="20" Width="70" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Wheel ID" HorizontalAlignment="Left" Margin="10,321,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Wheel ID</TextBlock> <LineBreak />
                           Custom wheel ID, from WHEEL_EX table.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->wheel</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_WheelID" ValueChanged="iud_WheelID_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="114,324,0,0" Height="20" Width="77" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Wheel Inch" HorizontalAlignment="Left" Margin="234,321,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Wheel Inch</TextBlock> <LineBreak />
                           Undocumented<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->wheel_inch_up</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:IntegerUpDown Name="iud_WheelInch" ValueChanged="iud_WheelInch_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="344,324,0,0" Height="20" Width="71" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Aero Kit" HorizontalAlignment="Left" Margin="11,352,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Aero Kit</TextBlock> <LineBreak />
                           Undocumented<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->aero_1</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_Aero1" ValueChanged="iud_Aero1_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="114,355,0,0" Height="20" Width="77" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Flat Floor" HorizontalAlignment="Left" Margin="10,383,0,0" VerticalAlignment="Top" Width="63">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Flat Floor</TextBlock> <LineBreak />
                           Undocumented<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->aero_2</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_Aero2" ValueChanged="iud_Aero2_ValueChanged" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="114,386,0,0" Height="20" Width="77" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Other (Aero)" HorizontalAlignment="Left" Margin="11,414,0,0" VerticalAlignment="Top" Width="Auto">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Other (Aero)</TextBlock> <LineBreak />
                           Undocumented<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->aero_3</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <xctk:SByteUpDown Name="iud_Aero3" ValueChanged="iud_Aero3_ValueChanged"  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="114,418,0,0" Height="20" Width="77" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Sticker Type" HorizontalAlignment="Left" Margin="234,352,0,0" VerticalAlignment="Top" Width="Auto"/>
                <ComboBox HorizontalAlignment="Left" IsEnabled="False" VerticalAlignment="Top" Margin="312,355,0,0" Height="20" Width="103" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Sticker Number Type" HorizontalAlignment="Left" Margin="232,383,0,0" VerticalAlignment="Top" Width="Auto"/>
                <ComboBox HorizontalAlignment="Left" IsEnabled="False" VerticalAlignment="Top" Margin="357,386,0,0" Height="20" Width="55" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Sticker Number" HorizontalAlignment="Left" Margin="234,414,0,0" VerticalAlignment="Top" Width="94"/>
                <xctk:ShortUpDown Name="iud_StickerNumber" ValueChanged="iud_StickerNumber_ValueChanged" HorizontalAlignment="Left" IsEnabled="False" VerticalAlignment="Top" Margin="341,418,0,0" Height="20" Width="71" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF"/>

                <Label Content="Front Tyres" HorizontalAlignment="Left" Margin="10,445,0,0" VerticalAlignment="Top" Width="84">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Front Tyres</TextBlock> <LineBreak />
                           Forced front tyres that the entry will use.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->tire_f</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <Label Content="Rear Tyres" HorizontalAlignment="Left" Margin="10,476,0,0" VerticalAlignment="Top" Width="84">
                    <Label.ToolTip>
                        <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Rear Tyres</TextBlock> <LineBreak />
                           Forced rear tyres that the entry will use.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontWeight="Bold">XML</TextBlock>: <TextBlock FontStyle="Italic">entry_base->tire_r</TextBlock>
                        </TextBlock>
                    </Label.ToolTip>
                </Label>
                <ComboBox Name="cb_EntryTireF" Margin="99,449,13,0" VerticalAlignment="Top" SelectionChanged="cb_EntryTireF_SelectionChanged">Use Car Defaults</ComboBox>
                <ComboBox Name="cb_EntryTireR" Margin="99,480,13,0" VerticalAlignment="Top" SelectionChanged="cb_EntryTireR_SelectionChanged">Use Car Defaults</ComboBox>
            </Grid>
        </GroupBox>
