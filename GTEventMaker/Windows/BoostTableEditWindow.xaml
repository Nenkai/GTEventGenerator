<Window x:Class="GTEventMaker.BoostTableEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:local="clr-namespace:GTEventMaker"
        mc:Ignorable="d"
        Title="Boost Table Settings Panel"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Height="546.813" Width="348.129">
    <DockPanel Background="#262626">
        <TabControl DockPanel.Dock="Top" Name="tabBoostTable" TabStripPlacement= "Top" IsTabStop="False" SelectionChanged="tabBoostTable_SelectionChanged">
            <TabItem Name="tabTable1">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" >
                        <Image Width="16" Source="Resources/UI/TabLogos/FolderInfo.png"/>
                        <TextBlock Text="Table 1" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
            <TabItem Name="tabTable2">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" >
                        <Image Width="16" Source="Resources/UI/TabLogos/FolderInfo.png"/>
                        <TextBlock Text="Table 2" />
                    </StackPanel>
                </TabItem.Header>
            </TabItem>
        </TabControl>
        <Grid DockPanel.Dock="Bottom">
            <GroupBox Canvas.Left="10" Canvas.Top="391" Margin="10,10,10,0" Height="189" VerticalAlignment="Top" >
                <GroupBox.Header>
                    <TextBlock Text="Front Boost (When AI is AHEAD of the player)"/>
                </GroupBox.Header>
                <Grid>
                    <Label Content="Boost Initial Rate" Canvas.Left="10" Canvas.Top="8" Width="213" Margin="10,10,103,0" Height="25" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Front Initial Rate</TextBlock> <LineBreak />
                           The first step of the boost.<LineBreak/>
                           This value also applies to how fast/slow the transition is from Initial to Maximum Rate.<LineBreak/> 
                           <LineBreak/>
                           <TextBlock FontStyle="Italic">Example:</TextBlock><LineBreak/>
                           If the value is set to 5, the enemy will receive a 1.05x boost when near the player.<LineBreak/>
                           When further ahead/behind, it will also speed up the transition from Initial to Maximum rate, such as 1.05x to 1.08x.
                        </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:SByteUpDown Name="iud_FrontRate1" ValueChanged="iud_FrontInitialRate_ValueChanged" Height="22" Width="70" Minimum="-99" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="0,13,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>

                    <Label Content="Boost Start" Canvas.Left="10" Canvas.Top="39" Margin="10,40,149,0" Height="26" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Front Start</TextBlock> <LineBreak />
                           This controls the distance it will take for the Maximum Rate to apply to the enemy car.<LineBreak/>
                           Distance in meters (possibly?).<LineBreak/> 
                           <LineBreak/>
                           <TextBlock FontStyle="Italic">Example:</TextBlock><LineBreak/>
                           If the value is set to 20, it will take approximately 20 meters ahead/behind the enemy car<LineBreak/>
                           for the start applying the Maximum Rate of the boost.
                        </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:ByteUpDown Name="iud_FrontDistance1" ValueChanged="iud_FrontStart_ValueChanged" Height="22" Width="70" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="0,42,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>

                    <Label Content="Boost Maximum Rate" Canvas.Left="10" Canvas.Top="68" Margin="10,72,128,0" Height="24" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Front Maximum Rate</TextBlock> <LineBreak />
                           The second step of the boost.<LineBreak/>
                           This is controlled by Start and Limit parameters, and is the highest the boost can go.<LineBreak/>
                           Once the distance for Start is met, this rate is applied.
                        </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:SByteUpDown Name="iud_FrontRate2" ValueChanged="iud_FrontMaximumRate_ValueChanged" Height="22" Width="70" Minimum="-99" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="0,72,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>

                    <Label Content="Boost Limit" Margin="10,103,122,0" Height="23" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Front Limit</TextBlock> <LineBreak />
                           This controls the distance it will take for the Maximum Rate to be <TextBlock FontWeight="Bold">fully</TextBlock> applied to the enemy car.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontStyle="Italic">Example:</TextBlock><LineBreak/>
                           If Initial Rate is 1.05x, Maximum Rate is 1.15x and Limit is 115, it will take 115 meters (might not be meters?)<LineBreak/>
                           for the boost to transition from 1.05x to 1.15x.
                        </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:ByteUpDown Name="iud_FrontDistance2" ValueChanged="iud_FrontLimit_ValueChanged" Height="22" Width="70" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="0,103,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                </Grid>
            </GroupBox>
            <GroupBox Margin="10,185,10,0" Height="190" VerticalAlignment="Top" >
                <GroupBox.Header>
                    <TextBlock Text="Rear Boost (When AI is BEHIND the player)"/>
                </GroupBox.Header>
                <Grid>
                    <Label Content="Boost Initial Rate" Margin="10,10,128,0" Height="25" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Rear Initial Rate</TextBlock> <LineBreak />
                           The first step of the boost.<LineBreak/>
                           This value also applies to how fast/slow the transition is from Initial to Maximum Rate.<LineBreak/> 
                           <LineBreak/>
                           <TextBlock FontStyle="Italic">Example:</TextBlock><LineBreak/>
                           If the value is set to 5, the enemy will receive a 1.05x boost when near the player.<LineBreak/>
                           When further ahead/behind, it will also speed up the transition from Initial to Maximum rate, such as 1.05x to 1.08x.
                        </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:SByteUpDown Name="iud_RearRate1" ValueChanged="iud_RearInitialRate_ValueChanged" Height="22" Width="70" Minimum="-99" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="0,12,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>

                    <Label Content="Boost Start" Margin="10,40,202,0" Height="26" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Rear Start</TextBlock> <LineBreak />
                           This controls the distance it will take for the Maximum Rate to apply to the enemy car.<LineBreak/>
                           Distance in meters (possibly?).<LineBreak/> 
                           <LineBreak/>
                           <TextBlock FontStyle="Italic">Example:</TextBlock><LineBreak/>
                           If the value is set to 20, it will take approximately 20 meters ahead/behind the enemy car<LineBreak/>
                           for the start applying the Maximum Rate of the boost.
                        </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:ByteUpDown Name="iud_RearDistance1" ValueChanged="iud_RearStart_ValueChanged" Height="22" Width="70" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="0,42,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>

                    <Label Content="Boost Maximum Rate" Width="213" Margin="10,71,103,0" Height="26" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Rear Maximum Rate</TextBlock> <LineBreak />
                           The second step of the boost.<LineBreak/>
                           This is controlled by Start and Limit parameters, and is the highest the boost can go.<LineBreak/>
                           Once the distance for Start is met, this rate is applied.
                        </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:SByteUpDown Name="iud_RearRate2" ValueChanged="iud_RearMaximumRate_ValueChanged" Height="22" Width="70" Minimum="-99" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="0,73,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>

                    <Label Content="Boost Limit" Canvas.Left="10" Canvas.Top="97" Margin="10,102,190,0" Height="26" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Rear Limit</TextBlock> <LineBreak />
                           This controls the distance it will take for the Maximum Rate to be <TextBlock FontWeight="Bold">fully</TextBlock> applied to the enemy car.<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontStyle="Italic">Example:</TextBlock><LineBreak/>
                           If Initial Rate is 1.05x, Maximum Rate is 1.15x and Limit is 115, it will take 115 meters (might not be meters?)<LineBreak/>
                           for the boost to transition from 1.05x to 1.15x.
                        </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:ByteUpDown Name="iud_RearDistance2" ValueChanged="iud_RearLimit_ValueChanged" Height="22" Width="70" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="0,104,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                </Grid>
            </GroupBox>
            <GroupBox Canvas.Left="10" Canvas.Top="391" Margin="10,361,10,10" >
                <GroupBox.Header>
                    <TextBlock Text="Misc"/>
                </GroupBox.Header>
                <Grid>
                    <Label Content="Reference Rank" Canvas.Left="10" Canvas.Top="8" Margin="10,10,85,0" Height="25" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Reference Rank</TextBlock> <LineBreak />
                           This is enabled by the boost_type bool (Boost Type checkbox in Race Settings), which must be enabled in order for this to function.<LineBreak/>
                           This controls when to apply boost based on your position in the race. For example...<LineBreak/>
                           <LineBreak/>
                           <TextBlock FontStyle="Italic">Example:</TextBlock><LineBreak/>
                           If the reference rank is set to 8, the boost will be applied if you are 9th in the event.
                        </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:ByteUpDown Name="iud_ReferenceRank" ValueChanged="iud_ReferenceRank_ValueChanged" Height="22" Width="70" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="0,13,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>

                    <Label Content="Race Progress Start (in %)" Canvas.Left="10" Canvas.Top="39" Margin="10,38,85,0" Height="26" VerticalAlignment="Top">
                        <Label.ToolTip>
                            <TextBlock>
                           <TextBlock FontWeight="Bold" FontSize="14">Race Progress Start</TextBlock> <LineBreak />
                           % of the race which this table will kick in. Between 0 and 100.<LineBreak/>
                        </TextBlock>
                        </Label.ToolTip>
                    </Label>
                    <xctk:ByteUpDown Name="iud_RaceProgress" ValueChanged="iud_RaceProgress_ValueChanged" Height="22" Width="70" BorderBrush="#323232" Background="#272727" Foreground="#FFFFFF" Margin="0,40,10,0" VerticalAlignment="Top" HorizontalAlignment="Right"/>

                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
