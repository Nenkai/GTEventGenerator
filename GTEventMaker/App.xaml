<Application x:Class="GTEventMaker.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GTEventMaker"
             DispatcherUnhandledException ="AppDispatcherUnhandledException"
             Startup="OnStartup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Themes/ColourDictionaries/SoftDark.xaml" />
                <ResourceDictionary Source="Resources/Themes/ControlColours.xaml"/>
                <ResourceDictionary Source="Resources/Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
